    },
    {
      "@type": "CollegeOrUniversity",
      "name": "Sylhet Polytechnic Institute",
      "sameAs": "https://spi.edu.bd/"
    }
  ],
  "award": [
    "3× ICPC Asia Dhaka Regional Contest Participant",
    "ICPC Asia Dhaka Regional Contest 2024 — Rank 157",
    "ICPC Asia Dhaka Regional Contest 2023 — Honorable Mention",
    "Meta Hacker Cup 2025 — Round 2 Qualifier",
    "BUBT Intra University Champion 2022, 2024",
    "UAP Inter University Programming Contest — 2nd Runner-up",
    "UIU Inter University Programming Contest 2025 — Participant",
    "BACS High School Programming Contest 2018 — 2nd Runner-up, Rajshahi Region",
