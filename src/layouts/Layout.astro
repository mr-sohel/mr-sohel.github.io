const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Md. Sohel Rana — Portfolio",
  "url": siteUrl,
  "description": description,
  "author": { "@type": "Person", "name": "Md. Sohel Rana", "url": siteUrl },
  "about": { "@type": "Person", "name": "Md. Sohel Rana" },
  "keywords": "Md. Sohel Rana, Sohel Rana, software engineer portfolio, backend developer, .NET developer, ASP.NET Core, competitive programmer, ICPC, C#, React, Angular, Bangladesh, BUBT, frontend developer, problem solving, algorithms"
