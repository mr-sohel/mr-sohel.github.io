---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Md. Sohel Rana" />
    <meta name="google-site-verification" content="x0yS52AZbrOXKragN9i9imUy3F-XxivvV4ZUtEA5ovk" />
    <meta name="keywords" content="Md. Sohel Rana, Sohel Rana, Md Sohel Rana, md-sohel-rana, mr-sohel, mrsohel, mrsohelcse, mr_sohel, Taalpatar_Shepai, Sohel Rana Software Engineer, Sohel Rana competitive programming, md-sohel-rana github, mrsohel github, Software Engineer, Full Stack Developer, Backend Developer, .NET Developer, ASP.NET Core Developer, C# Developer, Frontend Developer, React Developer, Competitive Programmer, software engineer Dhaka, React developer Bangladesh, algorithmic developer Bangladesh, ASP.NET Core, C#, .NET, Web API, Entity Framework Core, Angular, React, TypeScript, SQL Server, MySQL, Docker, Azure, Microservices, Clean Architecture, REST APIs, LINQ, SignalR, BUBT, BUBT CSE, Bangladesh, Dhaka, ICPC Regionalist, ICPC, Problem Solving, Data Structures, Algorithms, Codeforces, computer science student, BUBT CSE portfolio, Final Year CSE, Junior Software Engineer, Entry Level SWE, Hire .NET Developer, Backend Developer Portfolio, github-pages, c-plus-plus, frontend-developer, competitive-programming, software-engineer, cse, bubt" />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Md. Sohel Rana — Software Engineer Portfolio" />
    <meta property="og:site_name" content="Md. Sohel Rana" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@mrsohel" />
    <meta name="twitter:creator" content="@mrsohel" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Md. Sohel Rana — Software Engineer Portfolio" />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <main id="main-content">
      <slot />
    </main>

    <script>
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        }
      });
    </script>
  </body>
</html>

<style lang="scss" is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 9999;
    padding: 8px 16px;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--rounded-md);
    font-weight: 600;
    font-size: 14px;

    &:focus { top: 16px; }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
