  "alternateName": ["mr_sohel", "mr-sohel", "mrsohel", "mrsohelcse", "Taalpatar_Shepai", "md-sohel-rana"],
  "givenName": "Md. Sohel",
  "familyName": "Rana",
  "url": siteUrl,
  "image": ogImage,
  "jobTitle": "Software Engineer",
  "description": description,
  "email": "mailto:mrsohelcse@gmail.com",
  "address": { "@type": "PostalAddress", "addressCountry": "BD" },
  "birthPlace": { "@type": "Place", "address": { "@type": "PostalAddress", "addressCountry": "BD" } },
  "nationality": { "@type": "Country", "name": "Bangladesh" },
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
