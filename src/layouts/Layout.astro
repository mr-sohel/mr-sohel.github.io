  ],
  "hasCredential": [
    { "@type": "EducationalOccupationalCredential", "name": "Problem Solving (Intermediate)", "issuedBy": { "@type": "Organization", "name": "HackerRank", "sameAs": "https://www.hackerrank.com/" } },
    { "@type": "EducationalOccupationalCredential", "name": "Problem Solving (Basic)", "issuedBy": { "@type": "Organization", "name": "HackerRank", "sameAs": "https://www.hackerrank.com/" } },
    { "@type": "EducationalOccupationalCredential", "name": "NDG Linux Unhatched", "issuedBy": { "@type": "Organization", "name": "Cisco Networking Academy", "sameAs": "https://www.netacad.com/" } }
