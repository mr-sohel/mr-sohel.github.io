---
import '../styles/global.scss';
import { education, links, person, ratings, results, projects, skills, totals } from '../data/profile';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${person.name} (also known as Sohel Rana, Mr Sohel, mrsohel, mr-sohel) is a final-year CSE student at BUBT, Dhaka, building web apps and REST APIs with C#, ASP.NET Core, EF Core and SQL Server. ICPC Asia Dhaka Regional finalist and Codeforces Specialist with ${totals.problems} problems solved. Looking for a first full-time .NET or backend role.`
} = Astro.props;

const siteUrl = "https://mr-sohel.github.io";
const ogImage = `${siteUrl}/og-preview.jpg`;
const ogAlt = `${person.name}, .NET backend developer and final-year CSE student at BUBT`;
const lastUpdated = "2026-10-31T00:00:00+06:00";

const allSkills = skills.flatMap((group) => group.items);
const codeforces = ratings.find((r) => r.platform === 'Codeforces');

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "#sohel-rana",
  "name": person.name,
  "alternateName": [
    "Sohel",
    "Sohel Rana",
    "Mr Sohel",
    "Mr. Sohel",
    "Md Sohel Rana",
    "Sohel BUBT",
    "Sohel CSE",
    "Sohel Developer",
    "Sohel Programmer",
    "mr_sohel",
    "mr-sohel",
    "mrsohel",
    "mrsohelcse",
    "Taalpatar_Shepai",
    "md-sohel-rana"
  ],
  "givenName": "Md. Sohel",
  "familyName": "Rana",
  "url": siteUrl,
  "image": ogImage,
  "jobTitle": ".NET Backend Developer",
  "description": description,
  "email": `mailto:${person.email}`,
  "address": { "@type": "PostalAddress", "addressLocality": "Dhaka", "addressCountry": "BD" },
  "nationality": { "@type": "Country", "name": "Bangladesh" },
  "alumniOf": [
    {
      "@type": "CollegeOrUniversity",
      "name": `${person.university} (${person.universityShort})`,
      "sameAs": "https://www.bubt.edu.bd/"
    }
  ],
  "award": results
    .filter((r) => r.balloons > 0)
    .map((r) => `${r.event} — ${r.result}`),
  "knowsAbout": [...allSkills, "Competitive Programming"],
  "knowsLanguage": [
    { "@type": "Language", "name": "Bengali" },
    { "@type": "Language", "name": "English" }
  ],
  "sameAs": [
    links.github,
    links.linkedin,
    links.codeforces,
    links.leetcode,
    links.codechef,
    links.codolio
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": `${person.name} — Portfolio`,
  "url": siteUrl,
  "description": description,
  "datePublished": "2025-06-01T00:00:00+06:00",
  "dateModified": lastUpdated,
  "author": { "@type": "Person", "name": person.name, "url": siteUrl },
  "about": { "@type": "Person", "name": person.name },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".hero-name", ".hero-tagline"]
  }
};

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "dateCreated": "2025-06-01T00:00:00+06:00",
  "dateModified": lastUpdated,
  "mainEntity": {
    "@id": "#sohel-rana",
    "@type": "Person",
    "name": person.name,
    "url": siteUrl
  }
};

const faq = (question: string, answer: string) => ({
  "@type": "Question",
  "name": question,
  "acceptedAnswer": { "@type": "Answer", "text": answer }
});

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    faq(
      `Who is ${person.name}?`,
      `${person.name} is a final-year CSE student at ${person.universityShort}, a .NET backend developer and a competitive programmer with ${totals.problems} problems solved.`
    ),
    faq(
      `What technologies does ${person.name} use?`,
      `${person.name} builds web apps and REST APIs with C#, ASP.NET Core, EF Core and SQL Server, and uses C++ for competitive programming.`
    ),
    faq(
      `Is ${person.name} available for software engineering roles?`,
      `Yes. ${person.name} is looking for a first full-time .NET or backend role, starting after graduating in ${person.graduation}.`
    ),
    faq(
      "What is Sohel Rana's Codeforces rating?",
      `${person.name} (Codeforces handle: Mr_Sohel) has a Codeforces rating of ${codeforces?.rating}, which is ${codeforces?.standing}.`
    ),
    faq(
      "Where did Sohel Rana study?",
      `${person.name} is pursuing a ${education.degree} at ${person.university} (${person.universityShort}) in Dhaka, with expected graduation in ${person.graduation}.`
    ),
    faq(
      "What are Sohel Rana's ICPC results?",
      "Sohel Rana earned an Honorable Mention at the ICPC Asia Dhaka Regional 2025 and placed 157th at the ICPC Asia Dhaka Regional 2024, both with team BUBT Mudbloods."
    ),
    faq(
      `How can I contact ${person.name}?`,
      `Email ${person.email}, or reach out on LinkedIn at linkedin.com/in/mrsohel or GitHub at github.com/mr-sohel.`
    )
  ]
};

const publishedProjects = projects.filter((p) => !p.placeholder);

const projectsSchema = publishedProjects.length === 0 ? null : {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Projects by ${person.name}`,
  "itemListElement": publishedProjects.map((project, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "SoftwareApplication",
      "name": project.name,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "author": { "@type": "Person", "name": person.name },
      "description": project.summary,
      ...(project.repo ? { "url": project.repo } : {})
    }
  }))
};

const educationSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalCredential",
  "credentialCategory": "degree",
  "name": education.degree,
  "educationalLevel": "Bachelor's",
  "about": "Computer Science & Engineering",
  "recognizedBy": {
    "@type": "CollegeOrUniversity",
    "name": `${person.university} (${person.universityShort})`,
    "sameAs": "https://www.bubt.edu.bd/"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl }
  ]
};
const safeJsonLd = (data: any) => JSON.stringify(data).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');

const keywords = [
  person.name, "Sohel Rana", "Md Sohel Rana", "md-sohel-rana", "mr-sohel", "mrsohel", "mrsohelcse", "mr_sohel", "Taalpatar_Shepai",
  "Backend Developer", ".NET Developer", "ASP.NET Core Developer", "C# Developer", "Junior Software Engineer", "Entry Level SWE",
  "Competitive Programmer", "ICPC", "Codeforces", "BUBT", "BUBT CSE", "Dhaka", "Bangladesh",
  ...allSkills
].join(", ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />

    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), display-capture=(), autoplay=(), fullscreen=(self)" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content={person.name} />
    <meta name="google-site-verification" content="x0yS52AZbrOXKragN9i9imUy3F-XxivvV4ZUtEA5ovk" />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={siteUrl} />
    <link rel="me" href={links.github} />
    <link rel="me" href={links.linkedin} />
    <link rel="me" href={links.codeforces} />
    <link rel="me" href={links.leetcode} />

    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Md. Sohel" />
    <meta property="profile:last_name" content="Rana" />
    <meta property="profile:username" content="mr-sohel" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" set:html={safeJsonLd([personSchema, websiteSchema, faqSchema, profilePageSchema, projectsSchema, educationSchema, breadcrumbSchema].filter(Boolean))} />

    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', stored || (prefersDark ? 'dark' : 'light'));
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <main id="main-content">
      <slot />
    </main>

    <script>
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        if (!stored) {
          document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        }
      });
    </script>
  </body>
</html>

<style lang="scss" is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 9999;
    padding: 8px 16px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--rounded-md);
    font-weight: 600;
    font-size: 14px;

    &:focus { top: 16px; }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
