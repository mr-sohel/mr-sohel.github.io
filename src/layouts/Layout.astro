---
import '../styles/global.scss';
import AnimatedBackground from '../components/AnimatedBackground.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Final-year CSE student at BUBT | Competitive Programmer (3× ICPC Regionalist) | Building backend systems with C#, .NET, Docker, and Python ML."
} = Astro.props;

const siteUrl = "https://mr-sohel.github.io";
const ogImage = `${siteUrl}/og-preview.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Md. Sohel Rana",
  "url": siteUrl,
  "image": ogImage,
  "jobTitle": "Software Engineer",
  "description": description,
  "email": "mailto:mrsohelcse@gmail.com",
  "sameAs": [
    "https://github.com/mr-sohel",
    "https://www.linkedin.com/in/mrsohel/",
    "https://codeforces.com/profile/mr_sohel",
    "https://leetcode.com/u/mr_sohel/",
    "https://codolio.com/profile/mr_sohel"
  ],
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Bangladesh University of Business & Technology"
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Who is Md. Sohel Rana?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Md. Sohel Rana is a final-year Computer Science & Engineering student at Bangladesh University of Business & Technology (BUBT). He is a Software Engineer specializing in backend systems with C#, .NET, Docker, and Python, and a 3× ICPC Asia Dhaka Regionalist competitive programmer."
      }
    },
    {
      "@type": "Question",
      "name": "What technologies does Sohel Rana work with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sohel works with C#, ASP.NET Core, Python, Docker, PostgreSQL, Redis, PyTorch, and YOLOv8. His backend expertise includes .NET, REST APIs, and containerized deployments, while his ML work covers computer vision and deep learning."
      }
    },
    {
      "@type": "Question",
      "name": "What are Sohel Rana's competitive programming achievements?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sohel is a 3× ICPC Asia Dhaka Regionalist, Codeforces Specialist (peak rating 1619), LeetCode Knight (top 5%), and CodeChef 3-Star rated programmer. He has solved 1500+ algorithmic problems across multiple platforms and won BUBT Intra University Programming Contest twice."
      }
    },
    {
      "@type": "Question",
      "name": "What projects has Sohel Rana built?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sohel has built an Online Judge System (C#, .NET, Docker, PostgreSQL), a Real-Time Fruit Quality Detection system (98.97% mAP using YOLOv8), and a Facial Emotion Recognition for Autism system (89% accuracy using deep learning). All projects include impact metrics and source code."
      }
    },
    {
      "@type": "Question",
      "name": "Is Sohel Rana available for hire?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Md. Sohel Rana is actively seeking full-time Software Engineering and .NET Developer positions. He is available for immediate hiring and can be contacted via email at mrsohelcse@gmail.com or through LinkedIn."
      }
    },
    {
      "@type": "Question",
      "name": "What is Sohel Rana's CGPA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Md. Sohel Rana has a CGPA of 3.52 out of 4.00 in his B.Sc. in Computer Science & Engineering program at Bangladesh University of Business & Technology (BUBT)."
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Md. Sohel Rana" />
    <meta name="keywords" content="Sohel Rana, Software Engineer, Backend Developer, Competitive Programmer, ICPC, .NET, C#, Python, Machine Learning, BUBT, Bangladesh" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Md. Sohel Rana — Software Engineer Portfolio" />
    <meta property="og:site_name" content="Md. Sohel Rana" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet" />

    <!-- Theme Script (before paint to prevent flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Animated background (fixed, behind everything) -->
    <AnimatedBackground />

    <!-- Two-panel layout -->
    <div class="app-shell">
      <!-- Left: sticky sidebar (hidden on mobile) -->
      <div class="sidebar-wrapper">
        <Sidebar />
      </div>

      <!-- Right: scrollable main content -->
      <main id="main-content" class="main-panel">
        <!-- Top navigation strip -->
        <nav class="panel-nav glass" aria-label="Section navigation">
          <a href="#about" class="nav-link active" data-section="about">About</a>
          <a href="#education" class="nav-link" data-section="education">Education</a>
          <a href="#cp" class="nav-link" data-section="cp">CP</a>
          <a href="#projects" class="nav-link" data-section="projects">Projects</a>
          <a href="#experience" class="nav-link" data-section="experience">Experience</a>
          <a href="#skills" class="nav-link" data-section="skills">Skills</a>
          <a href="#contact" class="nav-link" data-section="contact">Contact</a>

          <!-- Mobile: hamburger + theme toggle -->
          <div class="mobile-nav-actions">
            <button id="mobile-theme-toggle" class="icon-btn" aria-label="Toggle theme">
              <svg class="sun-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg class="moon-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
            <a href="/Md_Sohel_Rana_Resume.pdf" class="resume-btn" target="_blank" rel="noopener noreferrer">Resume</a>
          </div>
        </nav>

        <!-- Mobile profile card (visible only on small screens) -->
        <div class="mobile-profile glass">
          <img src="/avatar.jpg" alt="Md. Sohel Rana" width="64" height="64" class="mobile-avatar" loading="eager" />
          <div>
            <h1 class="mobile-name">Md. Sohel Rana</h1>
            <p class="mobile-subtitle">Software Engineer · ICPC Regionalist</p>
          </div>
        </div>

        <!-- Hidden h1 for SEO (visible to screen readers and search engines) -->
        <h1 class="seo-h1 sr-only">Md. Sohel Rana — Software Engineer, Competitive Programmer, .NET Developer</h1>

        <!-- Page content injected here -->
        <div class="content-area">
          <slot />
        </div>
      </main>
    </div>

    <!-- Scroll reveal script -->
    <script>
      // Scroll reveal
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

      // Active nav link on scroll
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.nav-link[data-section]');

      const navObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navLinks.forEach(link => link.classList.remove('active'));
            const active = document.querySelector(`.nav-link[data-section="${entry.target.id}"]`);
            if (active) active.classList.add('active');
          }
        });
      }, { threshold: 0.4 });

      sections.forEach(s => navObserver.observe(s));

      // Mobile theme toggle
      document.getElementById('mobile-theme-toggle')?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });

      // OS theme change (no localStorage override)
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        }
      });
    </script>
  </body>
</html>

<style lang="scss" is:global>
  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 9999;
    padding: 8px 16px;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--rounded-md);
    font-weight: 700;
    font-size: 14px;

    &:focus { top: 16px; }
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* App shell */
  .app-shell {
    position: relative;
    z-index: 10;
    display: flex;
    gap: 12px;
    padding: 12px;
    min-height: 100vh;
    max-width: 1600px;
    margin: 0 auto;
    align-items: flex-start;
  }

  /* Sidebar wrapper: sticky on desktop, hidden on mobile */
  .sidebar-wrapper {
    display: none;
    width: var(--sidebar-width);
    flex-shrink: 0;
    position: sticky;
    top: 12px;
    height: calc(100vh - 24px);

    @media (min-width: 1024px) {
      display: block;
    }

    .sidebar {
      height: 100%;
      width: 100%;
    }
  }

  /* Main panel */
  .main-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    min-height: calc(100vh - 24px);
  }

  /* Top nav strip */
  .panel-nav {
    border-radius: var(--rounded-2xl);
    height: 48px;
    padding: 0 var(--spacing-xl);
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
    flex-shrink: 0;
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar { display: none; }
  }

  .nav-link {
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-ink-secondary);
    text-decoration: none;
    white-space: nowrap;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;

    &:hover { color: var(--color-ink); }

    &.active {
      color: var(--color-ink);
      border-bottom-color: var(--color-primary);
      text-shadow: 0 0 12px var(--color-primary-glow);
    }
  }

  .mobile-nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-shrink: 0;

    @media (min-width: 1024px) {
      display: none;
    }
  }

  .icon-btn {
    background: var(--color-glass);
    border: 1px solid var(--color-glass-border);
    color: var(--color-ink-secondary);
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: var(--rounded-md);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;

    &:hover { color: var(--color-primary); }
  }

  .sun-icon { display: none; }
  .moon-icon { display: block; }
  [data-theme="light"] .sun-icon { display: block; }
  [data-theme="light"] .moon-icon { display: none; }

  .resume-btn {
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--rounded-md);
    text-decoration: none;
    transition: background 0.2s ease;

    &:hover { background: var(--color-primary-deep); }
  }

  /* Mobile profile card */
  .mobile-profile {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--rounded-2xl);

    @media (min-width: 1024px) { display: none; }
  }

  .mobile-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-glass-border);
    flex-shrink: 0;
  }

  .mobile-name {
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    margin: 0 0 4px 0;
  }

  .mobile-subtitle {
    font-size: 12px;
    color: var(--color-ink-secondary);
    margin: 0;
  }

  /* Content area */
  .content-area {
    flex: 1;
    border-radius: var(--rounded-2xl);
    background: var(--color-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--color-glass-border);
    box-shadow: var(--shadow-glass);
    overflow: hidden;
  }
</style>
