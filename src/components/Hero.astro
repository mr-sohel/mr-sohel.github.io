<style lang="scss">
  .hero {
    padding: 160px var(--spacing-xl) var(--spacing-massive);
    min-height: 85vh;
    display: flex;
    align-items: center;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-name {
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -1.5px;
    line-height: 1.05;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-lg);
  }

  .hero-tagline {
    font-size: 18px;
    font-weight: 400;
    color: var(--color-ink-secondary);
    margin: 0 0 var(--spacing-huge);
    max-width: 600px;
    line-height: 1.6;
  }

  .hl {
    color: var(--color-primary);
    font-weight: 500;
  }

  /* Metrics strip */
  .metrics-strip {
    display: flex;
    align-items: center;
    gap: 40px;
    margin-bottom: var(--spacing-huge);
    flex-wrap: wrap;
  }

  .metric {
    text-align: left;
  }

  .metric-value {
    display: block;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .metric-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-mute);
    margin-top: 4px;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xxl);
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-on-primary);
    background: var(--color-primary);
    border-radius: var(--rounded-pill);
    touch-action: manipulation;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;

    &:hover {
      background: var(--color-primary-deep);
      color: var(--color-on-primary);
      transform: translateY(-1px);
    }
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-pill);
    touch-action: manipulation;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }
  }

  /* Social */
  .hero-social {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;

    a {
      color: var(--color-ink-mute);
      transition: color 0.2s ease, transform 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      border-radius: var(--rounded-md);
      touch-action: manipulation;

      &:hover {
        color: var(--color-ink);
        transform: translateY(-2px);
      }
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 120px var(--spacing-lg) var(--spacing-huge);
      min-height: auto;
    }

    .hero-name {
      font-size: 36px;
      letter-spacing: -0.8px;
    }

    .hero-tagline {
      font-size: 16px;
    }

    .metrics-strip {
      gap: var(--spacing-xxl);
    }

    .metric-value {
      font-size: 24px;
    }

    .hero-actions {
      flex-direction: column;

      .btn-primary, .btn-outline {
        width: 100%;
        justify-content: center;
      }
    }
  }

  @media (max-width: 480px) {
    .metrics-strip {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 400px) {
    .hero {
      padding: 100px var(--spacing-md) var(--spacing-huge);
    }

    .hero-name {
      font-size: 28px;
    }

    .hero-tagline {
      font-size: 14px;
    }

    .metric-value {
      font-size: 20px;
    }
  }
</style>
