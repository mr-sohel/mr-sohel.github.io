---
import Nav from './Nav.astro';
import Button from './Button.astro';
import { person, links } from '../data/profile';

// One balloon per contest result, matching the Standings table.
// Strings all meet at the badge's lanyard slot (210, 330 in the SVG).
const heroBalloons = [
  { level: 'international', x: 214, y: 58, delay: '-1.2s' },
  { level: 'regional', x: 128, y: 96, delay: '-4.1s' },
  { level: 'regional', x: 300, y: 104, delay: '-2.6s' },
  { level: 'inter', x: 48, y: 170, delay: '-5.4s' },
  { level: 'intra', x: 214, y: 182, delay: '-0.4s' },
  { level: 'intra', x: 372, y: 190, delay: '-3.3s' },
];
---

<Nav />

<section class="hero" id="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <h1 class="hero-name">Md. Sohel <span>Rana</span></h1>

      <p class="hero-tagline">
        {person.headline[0].toUpperCase() + person.headline.slice(1)} and competitive programmer.
        Final-year CSE student at {person.universityShort}, graduating {person.graduation}.
      </p>
      <p class="hero-detail">
        I build web apps and REST APIs with C#, ASP.NET Core, EF Core and SQL Server.
      </p>

      <div class="hero-actions">
        <Button href={person.resume} download={person.resumeFilename} variant="accent">Download resume</Button>
        <Button href="#contact" variant="ghost">Contact me</Button>
      </div>

      <ul class="hero-links label">
        <li><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={links.codeforces} target="_blank" rel="noopener noreferrer">Codeforces</a></li>
      </ul>
    </div>

    <figure class="lift">
      <svg class="lift-balloons" viewBox="0 0 420 336" aria-hidden="true">
        {heroBalloons.map((b) => (
          <g class="drift" style={`--delay: ${b.delay};`}>
            <path class="tether" d={`M${b.x} ${b.y + 62} Q ${(b.x + 210) / 2 + (b.x - 210) * 0.12} ${b.y + 150} 210 336`} />
            <g transform={`translate(${b.x} ${b.y})`} style={`--balloon: var(--balloon-${b.level});`}>
              <path class="knot" d="M-6 56 L0 45 L6 56 Z" />
              <path class="body" d="M0 -48 C 28 -48 42 -24 42 -4 C 42 22 16 40 0 48 C -16 40 -42 22 -42 -4 C -42 -24 -28 -48 0 -48 Z" />
              <ellipse class="shine" cx="-17" cy="-22" rx="6.5" ry="12" transform="rotate(24 -17 -22)" />
            </g>
          </g>
        ))}
      </svg>

      <div class="badge">
        <span class="badge-slot" aria-hidden="true"></span>
        <img src="/images/profile-kvvoya.jpg" alt={`Portrait of ${person.name}`} width="600" height="600" fetchpriority="high" />
        <p class="badge-name">{person.name}</p>
        <p class="badge-team label">Team {person.team}</p>
      </div>

      <figcaption class="lift-caption label">
        Six balloons, six contest results. <a href="#cp">See the standings</a>
      </figcaption>
    </figure>
  </div>
</section>

<style lang="scss">
  .hero {
    --focus: var(--on-field);
    position: relative;
    background: var(--field);
    color: var(--on-field);
    padding: 112px var(--gutter) 72px;
    overflow: clip;
  }

  .hero-inner {
    max-width: var(--measure);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 400px);
    gap: var(--spacing-huge);
    align-items: end;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(6rem, 12.4vw, 11.25rem);
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: 0.002em;
    text-transform: uppercase;
    white-space: nowrap;
    margin: 0 0 var(--spacing-xl);

    span {
      display: block;
      color: var(--balloon-intra);
    }
  }

  .hero-tagline {
    font-size: clamp(1.25rem, 2.1vw, 1.5rem);
    font-weight: 500;
    line-height: 1.35;
    max-width: 30em;
    margin: 0 0 var(--spacing-md);
  }

  .hero-detail {
    font-size: 1.0625rem;
    color: var(--on-field-mute);
    max-width: 40em;
    margin: 0 0 var(--spacing-xxl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xl);

    a {
      display: inline-block;
      padding-block: 8px;
      color: var(--on-field);

      &:hover {
        color: var(--balloon-intra);
      }
    }
  }

  /* Six balloons holding up a contest badge */
  .lift {
    margin: 0;
    width: 100%;
    max-width: 400px;
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lift-balloons {
    display: block;
    width: 100%;
    overflow: visible;
    margin-bottom: -6px;
    position: relative;
    z-index: 2;
  }

  .drift {
    transform-box: view-box;
    transform-origin: 210px 336px;
    animation: drift 7s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }

  @keyframes drift {
    from { transform: rotate(-2.2deg); }
    to { transform: rotate(2.2deg); }
  }

  .tether {
    fill: none;
    stroke: var(--on-field);
    stroke-width: 1.5;
    opacity: 0.7;
  }

  .body,
  .knot {
    fill: var(--balloon);
  }

  .shine {
    fill: #fff;
    opacity: 0.42;
  }

  .badge {
    position: relative;
    width: min(250px, 66%);
    padding: 28px 14px 16px;
    background: #fff;
    color: #17123a;
    border-radius: var(--rounded-xl);
    box-shadow: var(--shadow-lg);
    transform: rotate(-1.5deg);

    img {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      object-position: 50% 20%;
      border-radius: var(--rounded-md);
    }
  }

  .badge-slot {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 44px;
    height: 8px;
    margin-left: -22px;
    border-radius: var(--rounded-pill);
    background: var(--field);
  }

  .badge-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    margin: 12px 0 2px;
  }

  .badge-team {
    margin: 0;
    color: #45406a;
  }

  .lift-caption {
    margin-top: var(--spacing-xl);
    text-align: center;
    color: var(--on-field-mute);

    a {
      color: var(--on-field);
      white-space: nowrap;

      &:hover {
        color: var(--balloon-intra);
      }
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 96px;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }

    .hero-name {
      font-size: 23vw;
    }

    .lift {
      justify-self: center;
    }
  }

  @media (max-width: 480px) {
    .hero-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drift {
      animation: none;
    }
  }
</style>
