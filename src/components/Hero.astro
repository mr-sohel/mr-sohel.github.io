<style lang="scss">
  .hero {
    padding: 160px var(--spacing-xl) var(--spacing-massive);
    min-height: 85vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -20%;
    width: 140%;
    height: 140%;
    background: radial-gradient(ellipse at 30% 40%, rgba(13, 148, 136, 0.07) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 60%, rgba(13, 148, 136, 0.04) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 30%, rgba(45, 212, 191, 0.03) 0%, transparent 45%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--spacing-huge);
    align-items: center;
  }

  .hero-name {
    font-size: 64px;
    font-weight: 300;
    letter-spacing: -1.5px;
    line-height: 1.05;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-lg);
    text-wrap: balance;
  }

  .hero-tagline {
    font-size: 18px;
    font-weight: 400;
    color: var(--color-ink-secondary);
    margin: 0 0 var(--spacing-huge);
    max-width: 600px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .sep {
    margin: 0 6px;
    color: var(--color-ink-mute);
  }

  /* Metrics strip */
  .metrics-strip {
    display: flex;
    align-items: center;
    gap: 40px;
    margin-bottom: var(--spacing-huge);
    flex-wrap: wrap;
  }

  .metric {
    text-align: left;
  }

  .metric-value {
    display: block;
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--color-primary);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-mute);
    margin-top: 4px;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xxl);
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-on-primary);
    background: var(--color-primary-deep);
    border-radius: var(--rounded-pill);
    touch-action: manipulation;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;

    &:hover {
      background: var(--color-primary-press);
      color: var(--color-on-primary);
      transform: translateY(-1px);
    }
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-pill);
    touch-action: manipulation;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }
  }

  /* Social */
  .hero-social {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;

    a {
      color: var(--color-ink-mute);
      transition: color 0.2s ease, transform 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      border-radius: var(--rounded-md);
      touch-action: manipulation;

      &:hover {
        color: var(--color-ink);
        transform: translateY(-2px);
      }
    }
  }

  /* Profile photo */
  .hero-photo {
    display: flex;
    justify-content: center;
    align-items: center;

    img {
      width: 280px;
      height: 280px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid var(--color-border);
      box-shadow: 0 0 0 8px var(--color-primary-soft),
                  var(--shadow-lg);
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    img:hover {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 8px var(--color-primary-glow),
                  var(--shadow-lg);
    }
  }

  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-content {
      order: 2;
    }

    .hero-photo {
      order: 1;

      img {
        width: 200px;
        height: 200px;
      }
    }

    .hero-tagline {
      max-width: none;
    }

    .metrics-strip {
      justify-content: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-social {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 120px var(--spacing-lg) var(--spacing-huge);
      min-height: auto;
    }

    .hero-name {
      font-size: 36px;
      font-weight: 400;
      letter-spacing: -0.8px;
    }

    .hero-tagline {
      font-size: 16px;
    }

    .metrics-strip {
      gap: var(--spacing-xxl);
    }

    .metric-value {
      font-size: 32px;
    }

    .hero-actions {
      flex-direction: column;

      .btn-primary, .btn-outline {
        width: 100%;
        justify-content: center;
      }
    }
  }

  @media (max-width: 480px) {
    .metrics-strip {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-lg);
    }

    .hero-photo img {
      width: 160px;
      height: 160px;
    }
  }

  @media (max-width: 400px) {
    .hero {
      padding: 100px var(--spacing-md) var(--spacing-huge);
    }

    .hero-name {
      font-size: 28px;
    }

    .hero-tagline {
      font-size: 14px;
    }

    .metric-value {
      font-size: 20px;
    }
  }
</style>
