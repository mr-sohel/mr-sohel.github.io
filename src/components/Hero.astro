---
import Button from './Button.astro';
import GradientMesh from './GradientMesh.astro';
---

<section class="hero">
  <GradientMesh />
  
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title display-xxl">Md. Sohel Rana</h1>
      <p class="hero-subtitle heading-md">
        Software Engineer · Backend Developer · Competitive Programmer
      </p>
      
      <div class="hero-ctas">
        <Button href="/Md_Sohel_Rana_Resume.pdf" variant="primary">Download CV</Button>
        <Button href="#contact" variant="secondary">Contact Me</Button>
      </div>
      
      <div class="hero-social">
        <a href="https://github.com/mr-sohel" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
        <a href="https://www.linkedin.com/in/mrsohel/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="https://codeforces.com/profile/mr_sohel" target="_blank" rel="noopener noreferrer" aria-label="Codeforces">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="14" width="4" height="6" fill="currentColor" stroke="none"></rect>
            <rect x="10" y="8" width="4" height="12" fill="currentColor" stroke="none"></rect>
            <rect x="16" y="4" width="4" height="16" fill="currentColor" stroke="none"></rect>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    padding: 180px 0 120px;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-xl);
    width: 100%;
    position: relative;
    z-index: 10;
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-title {
    margin-bottom: var(--spacing-md);
  }

  .hero-subtitle {
    color: var(--color-ink-secondary);
    margin-bottom: var(--spacing-xxl);
    max-width: 600px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xxl);
  }

  .hero-social {
    display: flex;
    gap: var(--spacing-xl);
    align-items: center;
    
    a {
      color: var(--color-ink-mute);
      transition: color 0.2s ease, transform 0.2s ease;
      display: flex;
      align-items: center;
      
      &:hover {
        color: var(--color-primary);
        transform: translateY(-2px);
      }
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 140px 0 80px;
      min-height: auto;
    }
    
    .hero-ctas {
      flex-direction: column;
      gap: var(--spacing-md);
      
      :global(.btn) {
        width: 100%;
      }
    }
  }
</style>
