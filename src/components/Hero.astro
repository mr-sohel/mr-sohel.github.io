---
import Nav from './Nav.astro';
import Button from './Button.astro';
import IconGithub from './icons/IconGithub.astro';
---

<Nav />

<section class="hero" id="hero">
  <!-- Soft Gradient Mesh -->
  <div class="hero-mesh" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-content">
      <h1 class="hero-name">Md. Sohel Rana</h1>

      <p class="hero-tagline">
        Aspiring Software Engineer <span class="sep">•</span> 3× ICPC Regionalist <span class="sep">•</span> Codeforces Specialist
      </p>

      <!-- Sleek inline metrics -->
      <div class="metrics-strip reveal">
        <div class="metric">
          <span class="metric-value">1500+</span>
          <span class="metric-label">Problems Solved</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric">
          <span class="metric-value">3×</span>
          <span class="metric-label">ICPC Regional</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric">
          <span class="metric-value">50+</span>
          <span class="metric-label">Students Mentored</span>
        </div>
      </div>

      <div class="hero-actions reveal" style="transition-delay: 0.1s;">
        <Button href="#" onclick="event.preventDefault(); alert('My resume is currently being updated to match my latest projects. Please check back soon or contact me directly!');" variant="primary">Download Resume</Button>
        <Button href="#contact" variant="secondary">Contact Me</Button>
      </div>

      <div class="hero-social reveal" style="transition-delay: 0.2s;">
        <a href="https://github.com/mr-sohel" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <IconGithub width="24" height="24" />
        </a>
        <a href="https://www.linkedin.com/in/mrsohel/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://codeforces.com/profile/mr_sohel" target="_blank" rel="noopener noreferrer" aria-label="Codeforces">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.5 7.5C5.328 7.5 6 8.172 6 9v10.5c0 .828-.672 1.5-1.5 1.5h-3C.673 21 0 20.328 0 19.5V9c0-.828.673-1.5 1.5-1.5h3zm9-4.5c.828 0 1.5.672 1.5 1.5v15c0 .828-.672 1.5-1.5 1.5h-3c-.827 0-1.5-.672-1.5-1.5v-15c0-.828.673-1.5 1.5-1.5h3zm9 7.5c.828 0 1.5.672 1.5 1.5v7.5c0 .828-.672 1.5-1.5 1.5h-3c-.828 0-1.5-.672-1.5-1.5V12c0-.828.672-1.5 1.5-1.5h3z"/>
          </svg>
        </a>
        <a href="https://leetcode.com/u/mr_sohel/" target="_blank" rel="noopener noreferrer" aria-label="LeetCode">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"/></svg>
        </a>
      </div>
    </div>

    <div class="hero-photo reveal">
      <div class="photo-wrapper">
        <img src="/images/profile-kvvoya.jpg" alt="Md. Sohel Rana" width="400" height="400" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    padding: 180px var(--spacing-xl) 100px;
    position: relative;
    overflow: hidden;
  }

  .hero-mesh {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 10% 20%, var(--color-primary-soft) 0%, transparent 35%),
                radial-gradient(circle at 90% 60%, rgba(16, 185, 129, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 50% 80%, rgba(83, 58, 253, 0.04) 0%, transparent 50%);
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
    transform: translateZ(0);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, var(--color-bg) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-massive);
  }

  .hero-content {
    flex: 1;
    max-width: 650px;
  }

  .hero-name {
    font-size: 80px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--color-ink);
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .hero-tagline {
    font-size: 20px;
    font-weight: 400;
    color: var(--color-ink-secondary);
    margin: 0 0 40px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .sep {
    margin: 0 8px;
    color: var(--color-primary);
    opacity: 0.5;
  }

  .metrics-strip {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .metric-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  .metric {
    text-align: left;
  }

  .metric-value {
    display: block;
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-primary);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink-mute);
    margin-top: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .hero-social {
    display: flex;
    gap: 16px;
    align-items: center;

    a {
      color: var(--color-ink);
      transition: color 0.2s ease, transform 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;

      &:hover {
        color: var(--color-primary);
        transform: translateY(-2px) scale(1.1);
      }
    }
  }

  .hero-photo {
    flex-shrink: 0;
    width: 360px;

    .photo-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 1;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: var(--shadow-lg), 0 20px 40px -10px var(--color-primary-soft);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      transform: rotate(3deg);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);

      &:hover {
        transform: rotate(0deg) translateY(-8px);
      }
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scale(1.05);
    }
  }

  @media (max-width: 1024px) {
    .hero-inner {
      flex-direction: column;
      text-align: center;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 100%;
    }

    .hero-photo {
      width: 280px;
      order: -1;
      margin-bottom: var(--spacing-xl);

      .photo-wrapper {
        transform: rotate(0deg);
      }
    }

    .metric-divider { display: none; }

    .metrics-strip {
      justify-content: center;
      gap: 40px;
      padding: 24px;
      background: var(--color-surface);
      border-radius: var(--rounded-xl);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-sm);
    }

    .metric { text-align: center; }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 140px var(--spacing-lg) 80px;
    }

    .hero-name { font-size: 56px; }
    .hero-tagline { font-size: 18px; }

    .metrics-strip { gap: 24px; }
    .metric-value { font-size: 32px; }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }
  }

  @media (max-width: 480px) {
    .hero-name { font-size: 40px; }
    .hero-photo { width: 200px; }

    .metrics-strip {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      width: 100%;
    }
    .metric:last-child {
      grid-column: 1 / -1;
    }
  }
</style>