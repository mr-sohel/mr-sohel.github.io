---
import Nav from './Nav.astro';
import Button from './Button.astro';
import { person, links, ratings, results, totals } from '../data/profile';

const rating = (platform: string) => ratings.find((r) => r.platform === platform)?.rating;
const regionals = results.filter((r) => r.level === 'regional').length;

const stats = [
  { value: totals.problems, label: 'problems solved' },
  { value: totals.contests, label: 'contests' },
  { value: totals.students, label: 'students mentored' },
];
---

<Nav />

<section class="hero" id="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <p class="status">
        <img src="/images/profile-kvvoya.jpg" alt={`Portrait of ${person.name}`} width="40" height="40" fetchpriority="high" />
        <span class="label"><i class="dot" aria-hidden="true"></i>Open to work from {person.graduation}</span>
      </p>

      <h1 class="hero-name">{person.name}</h1>

      <p class="hero-tagline">
        {person.headline[0].toUpperCase() + person.headline.slice(1)} and competitive programmer.
        Final-year CSE student at {person.universityShort}, graduating {person.graduation}.
      </p>
      <p class="hero-detail">
        I build web apps and REST APIs with C#, ASP.NET Core, EF Core and SQL Server, and I think
        in algorithms because I train on them every week.
      </p>

      <div class="hero-actions">
        <Button href={person.resume} download={person.resumeFilename} variant="primary">Download resume</Button>
        <Button href="#contact" variant="secondary">Contact me</Button>
      </div>

      <ul class="hero-links label">
        <li><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={links.codeforces} target="_blank" rel="noopener noreferrer">Codeforces</a></li>
      </ul>
    </div>

    <figure class="editor" aria-label="Profile summary written as a C# object">
      <div class="editor-bar">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="editor-tab label">Engineer.cs</span>
      </div>
      <pre class="code" tabindex="0"><code><span class="ln"><span class="c">// Final-year CSE, graduating {person.graduation}</span></span>
<span class="ln"><span class="k">var</span> sohel = <span class="k">new</span> <span class="t">Engineer</span></span>
<span class="ln">{'{'}</span>
<span class="ln">    Name = <span class="s">"{person.name}"</span>,</span>
<span class="ln">    Role = <span class="s">".NET backend developer"</span>,</span>
<span class="ln">    Stack = [<span class="s">"C#"</span>, <span class="s">"ASP.NET Core"</span>, <span class="s">"EF Core"</span>, <span class="s">"SQL Server"</span>],</span>
<span class="ln">    Based = <span class="s">"{person.location}"</span>,</span>
<span class="ln">    Codeforces = <span class="n">{rating('Codeforces')}</span>,</span>
<span class="ln">    CodeChef = <span class="n">{rating('CodeChef')}</span>,</span>
<span class="ln">    LeetCode = <span class="n">{rating('LeetCode')}</span>,</span>
<span class="ln">    IcpcRegionals = <span class="n">{regionals}</span>,</span>
<span class="ln">    OpenToWork = <span class="k">true</span>,</span>
<span class="ln">{'};'}</span></code></pre>
    </figure>
  </div>

  <ul class="stats">
    {stats.map((s) => (
      <li>
        <span class="stat-value">{s.value}</span>
        <span class="stat-label">{s.label}</span>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  .hero {
    position: relative;
    padding: 128px var(--gutter) 72px;
    background:
      linear-gradient(color-mix(in srgb, var(--color-border) 45%, transparent) 1px, transparent 1px) 0 0 / 100% 56px,
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    overflow: clip;

    /* Fade the faint ruled lines out toward the bottom */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 30%, var(--color-bg) 92%);
      pointer-events: none;
    }
  }

  .hero-inner,
  .stats {
    position: relative;
    z-index: 1;
    max-width: var(--measure);
    margin: 0 auto;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--spacing-huge);
    align-items: center;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-md);
    margin: 0 0 var(--spacing-xl);
    padding: 4px 16px 4px 4px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-pill);
    box-shadow: var(--shadow-sm);

    img {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
      object-position: 50% 20%;
    }

    .label {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-sm);
      color: var(--color-ink-secondary);
    }
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-up);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-up) 22%, transparent);
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 0 var(--spacing-lg);
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    font-weight: 500;
    line-height: 1.45;
    max-width: 30em;
    margin: 0 0 var(--spacing-md);
  }

  .hero-detail {
    color: var(--color-ink-secondary);
    max-width: 36em;
    margin: 0 0 var(--spacing-xxl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xl);

    a {
      display: inline-block;
      padding-block: 8px;
      color: var(--color-ink-secondary);

      &:hover {
        color: var(--color-primary);
      }
    }
  }

  /* The signature: the profile as a typed object in a code editor */
  .editor {
    margin: 0;
    min-width: 0;
    background: var(--code-bg);
    border: 1px solid var(--code-line);
    border-radius: var(--rounded-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .editor-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    padding: 0 var(--spacing-lg);
    background: var(--code-bar);
    border-bottom: 1px solid var(--code-line);
  }

  .lights {
    display: flex;
    gap: 6px;

    i {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--code-line);
    }
  }

  .editor-tab {
    padding: 10px 14px;
    color: var(--code-ink);
    border-bottom: 2px solid var(--code-keyword);
    margin-bottom: -1px;
  }

  .code {
    margin: 0;
    padding: var(--spacing-lg) 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.85;
    color: var(--code-ink);
    counter-reset: line;

    code {
      display: block;
      min-width: max-content;
      font-family: inherit;
      /* Each .ln is its own block, so the source newlines must not add blank lines */
      white-space: normal;
    }

    .ln {
      display: block;
      padding-right: var(--spacing-xl);
      white-space: pre;

      &::before {
        counter-increment: line;
        content: counter(line);
        display: inline-block;
        width: 3.25em;
        padding-right: 1.5em;
        text-align: right;
        color: var(--code-mute);
        user-select: none;
      }
    }

    .k { color: var(--code-keyword); }
    .t { color: var(--code-type); }
    .s { color: var(--code-string); }
    .n { color: var(--code-number); }
    .c { color: var(--code-mute); }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--spacing-massive);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-lg);
    box-shadow: var(--shadow-sm);

    li {
      display: flex;
      align-items: baseline;
      gap: var(--spacing-md);
      padding: var(--spacing-xl);
    }

    li + li {
      border-left: 1px solid var(--color-border);
    }
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-label {
    color: var(--color-ink-mute);
    font-size: 0.9375rem;
  }

  @media (max-width: 960px) {
    .hero {
      padding-top: 104px;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-xxl);
    }

    .stats {
      margin-top: var(--spacing-huge);
    }
  }

  @media (max-width: 600px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);

      li + li {
        border-left: 0;
        border-top: 1px solid var(--color-border);
      }

      li {
        padding: var(--spacing-lg);
      }
    }

    .hero-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
