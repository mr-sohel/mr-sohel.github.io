---
import Button from './Button.astro';
import { links, person } from '../data/profile';

const mailto = `mailto:${person.email}?subject=${encodeURIComponent('Software engineering role')}`;
---

<section id="contact" class="section">
  <div class="section-inner">
    <div class="contact-card">
      <div class="contact-copy">
        <span class="eyebrow">Contact</span>
        <h2 class="section-title">Hiring a junior .NET developer?</h2>
        <p class="contact-intro">
          I'm based in {person.location} and open to on-site, remote and relocation roles,
          starting after I graduate in {person.graduation}.
        </p>
        <a class="contact-email" href={mailto}>{person.email}</a>
      </div>

      <div class="contact-actions">
        <Button href={mailto} variant="primary">Email me</Button>
        <Button href={person.resume} download={person.resumeFilename} variant="secondary">Download resume</Button>
        <ul class="contact-links label">
          <li><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--spacing-xxl) var(--spacing-huge);
    align-items: end;
    padding: clamp(28px, 5vw, 56px);
    background: var(--color-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-xl);
  }

  .contact-intro {
    max-width: 32em;
    margin: var(--spacing-md) 0 var(--spacing-lg);
    font-size: 1.0625rem;
    color: var(--color-ink-secondary);
  }

  .contact-email {
    font-family: var(--font-mono);
    font-size: clamp(0.9375rem, 2.2vw, 1.125rem);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: flex-end;
  }

  .contact-links {
    flex-basis: 100%;
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-xl);

    a {
      display: inline-block;
      padding-block: 8px;
    }
  }

  @media (max-width: 860px) {
    .contact-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact-actions,
    .contact-links {
      justify-content: flex-start;
    }
  }

  @media (max-width: 480px) {
    .contact-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
