<section id="contact" class="content-section bordered-top">
  <div class="section-heading reveal">
    <h2>Contact</h2>
    <div class="heading-bar"></div>
  </div>

  <div class="contact-wrapper">
    <div class="contact-left reveal">
      <p class="contact-intro">
        I'm currently looking for full-time Software Engineering opportunities.
        Whether you have a question, a role, or just want to say hi —
        I'll get back to you!
      </p>

      <div class="contact-links">
        <a href="mailto:mrsohelcse@gmail.com" class="contact-link">
          <span class="link-icon" aria-hidden="true">✉️</span>
          <span>mrsohelcse@gmail.com</span>
        </a>
        <a href="https://www.linkedin.com/in/mrsohel/" target="_blank" rel="noopener noreferrer" class="contact-link">
          <span class="link-icon" aria-hidden="true">💼</span>
          <span>linkedin.com/in/mrsohel</span>
        </a>
        <a href="https://github.com/mr-sohel" target="_blank" rel="noopener noreferrer" class="contact-link">
          <span class="link-icon" aria-hidden="true">🐙</span>
          <span>github.com/mr-sohel</span>
        </a>
      </div>
    </div>

    <div class="contact-right reveal">
      <a href="mailto:mrsohelcse@gmail.com" class="say-hello-btn">
        Say Hello 👋
      </a>
      <a href="/Md_Sohel_Rana_Resume.pdf" target="_blank" rel="noopener noreferrer" class="resume-dl-btn">
        Download Resume
      </a>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer-strip">
    <p class="footer-text">Built with Astro · Deployed on GitHub Pages · © 2025 Md. Sohel Rana</p>
  </div>
</section>

<style lang="scss">
  .content-section {
    padding: var(--spacing-xxl);
    @media (max-width: 768px) { padding: var(--spacing-xl) var(--spacing-lg); }
  }
  .bordered-top { border-top: 1px solid var(--color-glass-border); }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--spacing-xxl);
    align-items: start;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .contact-intro {
    font-size: 15px;
    color: var(--color-ink-secondary);
    line-height: 1.7;
    margin: 0 0 var(--spacing-xl) 0;
    max-width: 500px;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-md);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink-secondary);
    text-decoration: none;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--rounded-lg);
    background: var(--color-glass);
    border: 1px solid var(--color-glass-border);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;

    &:hover {
      color: var(--color-primary);
      border-color: rgba(83, 58, 253, 0.3);
      transform: translateX(4px);
    }
  }

  .link-icon { font-size: 16px; }

  .contact-right {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: stretch;
    min-width: 180px;
  }

  .say-hello-btn {
    display: block;
    text-align: center;
    padding: var(--spacing-md) var(--spacing-xl);
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    border-radius: var(--rounded-lg);
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;

    &:hover {
      background: var(--color-primary-deep);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px var(--color-primary-glow);
    }
  }

  .resume-dl-btn {
    display: block;
    text-align: center;
    padding: var(--spacing-md) var(--spacing-xl);
    background: var(--color-glass);
    color: var(--color-ink);
    font-weight: 700;
    font-size: 14px;
    border: 1px solid var(--color-glass-border);
    border-radius: var(--rounded-lg);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;

    &:hover {
      border-color: rgba(83, 58, 253, 0.4);
      color: var(--color-primary);
    }
  }

  .footer-strip {
    margin-top: var(--spacing-xxl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-glass-border);
    text-align: center;
  }

  .footer-text {
    font-size: 12px;
    color: var(--color-ink-mute);
    margin: 0;
  }
</style>
