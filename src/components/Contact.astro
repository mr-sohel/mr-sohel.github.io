---
import Button from './Button.astro';
import { links, person } from '../data/profile';

const mailto = `mailto:${person.email}?subject=${encodeURIComponent('Software engineering role')}`;
---

<section id="contact" class="contact">
  <div class="section-inner">
    <h2 class="section-title">Hiring a junior .NET developer?</h2>

    <div class="contact-body">
      <div>
        <p class="contact-intro">
          I'm based in {person.location} and open to on-site, remote and relocation roles,
          starting after I graduate in {person.graduation}.
        </p>
        <a class="contact-email" href={mailto}>{person.email}</a>
      </div>

      <div class="contact-actions">
        <Button href={mailto} variant="accent">Email me</Button>
        <Button href={person.resume} download={person.resumeFilename} variant="ghost">Download resume</Button>
        <ul class="contact-links label">
          <li><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .contact {
    --focus: var(--on-field);
    padding: var(--spacing-massive) var(--gutter);
    background: var(--field);
    color: var(--on-field);

    a:not(:global(.btn)) {
      color: var(--on-field);

      &:hover {
        color: var(--balloon-intra);
      }
    }

    .section-title {
      font-size: clamp(3.5rem, 11vw, 8.5rem);
      line-height: 0.88;
      max-width: 9em;
      margin-bottom: var(--spacing-huge);
    }
  }

  .contact-body {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--spacing-xxl) var(--spacing-huge);
    align-items: end;
  }

  .contact-intro {
    font-size: 1.25rem;
    line-height: 1.4;
    max-width: 30em;
    margin: 0 0 var(--spacing-lg);
  }

  .contact-email {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.4vw, 1.375rem);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: flex-end;
  }

  .contact-links {
    flex-basis: 100%;
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-xl);

    a {
      display: inline-block;
      padding-block: 8px;
    }
  }

  @media (max-width: 860px) {
    .contact {
      padding-block: 64px;
    }

    .contact-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact-actions,
    .contact-links {
      justify-content: flex-start;
    }
  }

  @media (max-width: 480px) {
    .contact-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
