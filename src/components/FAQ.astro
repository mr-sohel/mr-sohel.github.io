---
const faqs = [
  {
    question: "Who is Md. Sohel Rana?",
    answer: "Md. Sohel Rana is a final-year Computer Science & Engineering student at Bangladesh University of Business & Technology (BUBT). He is a Software Engineer specializing in backend systems with C#, .NET, Docker, and Python, and a 3× ICPC Asia Dhaka Regionalist competitive programmer."
  },
  {
    question: "What technologies does Sohel Rana work with?",
    answer: "Sohel works with C#, ASP.NET Core, Python, Docker, PostgreSQL, Redis, PyTorch, and YOLOv8. His backend expertise includes .NET, REST APIs, and containerized deployments, while his ML work covers computer vision and deep learning."
  },
  {
    question: "What are Sohel Rana's competitive programming achievements?",
    answer: "Sohel is a 3× ICPC Asia Dhaka Regionalist, Codeforces Specialist (peak rating 1619), LeetCode Knight (top 5%), and CodeChef 3-Star rated programmer. He has solved 1500+ algorithmic problems across multiple platforms and won BUBT Intra University Programming Contest twice."
  },
  {
    question: "What projects has Sohel Rana built?",
    answer: "Sohel has built an Online Judge System (C#, .NET, Docker, PostgreSQL), a Real-Time Fruit Quality Detection system (98.97% mAP using YOLOv8), and a Facial Emotion Recognition for Autism system (89% accuracy using deep learning). All projects include impact metrics and source code."
  },
  {
    question: "Is Sohel Rana available for hire?",
    answer: "Yes, Md. Sohel Rana is actively seeking full-time Software Engineering and .NET Developer positions. He is available for immediate hiring and can be contacted via email at mrsohelcse@gmail.com or through LinkedIn."
  },
  {
    question: "What is Sohel Rana's CGPA?",
    answer: "Md. Sohel Rana has a CGPA of 3.52 out of 4.00 in his B.Sc. in Computer Science & Engineering program at Bangladesh University of Business & Technology (BUBT)."
  }
];
---

<section id="faq" class="content-section bordered-top">
  <div class="section-heading reveal">
    <h2>Frequently Asked Questions</h2>
    <div class="heading-bar"></div>
  </div>

  <div class="faq-list">
    {faqs.map((faq, index) => (
      <details class="faq-item glass reveal" open={index === 0}>
        <summary class="faq-question">
          <span>{faq.question}</span>
          <svg class="faq-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>
        <div class="faq-answer">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style lang="scss">
  .content-section {
    padding: var(--spacing-xxl);
    @media (max-width: 768px) { padding: var(--spacing-xl) var(--spacing-lg); }
  }
  .bordered-top { border-top: 1px solid var(--color-glass-border); }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .faq-item {
    border-radius: var(--rounded-xl);
    overflow: hidden;
    transition: border-color 0.2s ease;

    &:hover { border-color: rgba(83, 58, 253, 0.3); }

    &[open] .faq-icon { transform: rotate(180deg); }
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    cursor: pointer;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-ink);
    list-style: none;

    &::-webkit-details-marker { display: none; }
    &::marker { display: none; content: ''; }
  }

  .faq-icon {
    flex-shrink: 0;
    color: var(--color-ink-secondary);
    transition: transform 0.2s ease;
  }

  .faq-answer {
    padding: 0 var(--spacing-lg) var(--spacing-lg);

    p {
      margin: 0;
      font-size: 14px;
      color: var(--color-ink-secondary);
      line-height: 1.7;
    }
  }
</style>
