---
import { person } from '../data/profile';

const now = [
  { label: 'Studying', body: `BSc in CSE at ${person.universityShort}. Graduating ${person.graduation}.` },
  { label: 'Learning', body: 'ASP.NET Core MVC course at DevSkill.' },
  { label: 'Building', body: 'Two .NET backend projects, in progress.' },
  { label: 'Looking for', body: 'A first full-time .NET or backend role.' },
];
---

<section id="about" class="now" aria-label="About">
  <dl class="now-grid">
    {now.map((item) => (
      <div class="now-item">
        <dt class="label">{item.label}</dt>
        <dd>{item.body}</dd>
      </div>
    ))}
  </dl>
</section>

<style lang="scss">
  .now {
    padding: var(--spacing-massive) var(--gutter) 0;
  }

  .now-grid {
    max-width: var(--measure);
    margin: 0;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-lg);
  }

  .now-item {
    padding: var(--spacing-lg) var(--spacing-xl) var(--spacing-xl) 0;
    border-top: 2px solid var(--color-border);
    transition: border-color 0.2s ease;

    &:hover {
      border-top-color: var(--color-primary);
    }

    dt {
      color: var(--color-primary);
      margin-bottom: var(--spacing-sm);
    }

    dd {
      margin: 0;
      font-size: 1rem;
      line-height: 1.5;
      color: var(--color-ink);
    }
  }

  @media (max-width: 900px) {
    .now-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .now {
      padding-top: 64px;
    }

    .now-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
