---
import { person, sellwise } from '../data/profile';

const now = [
  { label: 'Studying', body: `BSc in CSE at ${person.universityShort}. Graduating ${person.graduation}.` },
  { label: 'Learning', body: 'ASP.NET Core MVC course at DevSkill.' },
  { label: 'Built', body: `${sellwise.name}, a retail SaaS on ASP.NET Core and SQL Server.` },
  { label: 'Looking for', body: 'A first full-time .NET or backend role.' },
];
---

<section id="about" class="now" aria-label="About">
  <dl class="now-grid">
    {now.map((item) => (
      <div class="now-item">
        <dt class="label">{item.label}</dt>
        <dd>{item.body}</dd>
      </div>
    ))}
  </dl>
</section>

<style lang="scss">
  .now {
    padding: 0 var(--gutter);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .now-grid {
    max-width: var(--measure);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .now-item {
    padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-xl) 0;

    & + & {
      padding-left: var(--spacing-xl);
      border-left: 1px solid var(--color-border);
    }

    dt {
      color: var(--color-primary);
      margin-bottom: var(--spacing-xs);
    }

    dd {
      margin: 0;
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.4;
    }
  }

  @media (max-width: 900px) {
    .now-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .now-item {
      padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-lg) 0;

      & + & {
        padding-left: 0;
        border-left: 0;
      }

      &:nth-child(even) {
        padding-left: var(--spacing-lg);
        border-left: 1px solid var(--color-border);
      }

      &:nth-child(n + 3) {
        border-top: 1px solid var(--color-border);
      }
    }
  }

  @media (max-width: 480px) {
    .now-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .now-item,
    .now-item:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }

    .now-item + .now-item {
      border-top: 1px solid var(--color-border);
    }
  }
</style>
