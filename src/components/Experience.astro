<section id="experience" class="experience section-padding">
  <div class="container">
    <h2 class="heading-lg mb-xl">Experience & Leadership</h2>
    
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-header">
            <div>
              <h3 class="heading-md">Competitive Programming Instructor</h3>
              <p class="organization body-md">BUBT CP Community</p>
            </div>
            <div class="timeline-date body-tabular">August 2024 – April 2026</div>
          </div>
          
          <ul class="timeline-body">
            <li>Mentored 50+ students in C/C++ programming, data structures, and algorithms, focusing on optimization techniques for ICPC-style problem solving.</li>
            <li>Organized coding contests for junior members on virtual judge platforms to improve university-wide contest participation and ranking.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .section-padding {
    padding: var(--spacing-xxl) 0;
  }

  .container {
    max-width: 800px; /* Narrower container for timeline */
    margin: 0 auto;
    padding: 0 var(--spacing-xl);
  }

  .mb-xl {
    margin-bottom: var(--spacing-xxl);
  }

  .timeline {
    position: relative;
    padding-left: var(--spacing-xl);
    
    &::before {
      content: '';
      position: absolute;
      left: 7px;
      top: 0;
      bottom: 0;
      width: 2px;
      background-color: var(--color-hairline);
    }
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--spacing-xxl);
    
    &:last-child {
      margin-bottom: 0;
    }
  }

  .timeline-dot {
    position: absolute;
    left: calc(-1 * var(--spacing-xl) - 4px);
    top: 6px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--color-canvas);
    border: 3px solid var(--color-primary);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
    
    @media (max-width: 600px) {
      flex-direction: column;
    }
  }

  h3 {
    margin-bottom: 4px;
    color: var(--color-ink);
  }

  .organization {
    color: var(--color-ink-secondary);
    margin: 0;
    font-weight: 500;
  }

  .timeline-date {
    color: var(--color-ink-mute);
    background-color: var(--color-canvas-soft);
    padding: 4px 12px;
    border-radius: var(--rounded-pill);
    font-size: 13px;
  }

  .timeline-body {
    padding-left: var(--spacing-lg);
    margin: 0;
    color: var(--color-ink-secondary);
    line-height: 1.6;
    
    li {
      margin-bottom: var(--spacing-xs);
      
      &:last-child {
        margin-bottom: 0;
      }
    }
  }
</style>
