<section id="experience" class="content-section bordered-top">
  <div class="section-heading reveal">
    <h2>Experience</h2>
    <div class="heading-bar"></div>
  </div>

  <div class="timeline">
    <div class="timeline-item reveal">
      <div class="timeline-dot" aria-hidden="true"></div>
      <div class="timeline-card glass">
        <div class="exp-header">
          <div>
            <h3 class="exp-role">Competitive Programming Instructor</h3>
            <p class="exp-org">BUBT Programming Club — Bangladesh University of Business &amp; Technology</p>
          </div>
          <span class="exp-date">2022 – Present</span>
        </div>
        <ul class="exp-bullets">
          <li>Mentored 50+ students in competitive programming fundamentals, data structures, and algorithms</li>
          <li>Conducted weekly training sessions and mock contests to prepare teams for ICPC regionals</li>
          <li>Designed problem sets and editorial write-ups for intra-university programming contests</li>
        </ul>
        <div class="exp-tags">
          <span class="tag">Teaching</span>
          <span class="tag">Algorithms</span>
          <span class="tag">ICPC Prep</span>
          <span class="tag">Problem Setting</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .content-section {
    padding: var(--spacing-xxl);
    @media (max-width: 768px) { padding: var(--spacing-xl) var(--spacing-lg); }
  }
  .bordered-top { border-top: 1px solid var(--color-glass-border); }

  .timeline {
    position: relative;
    padding-left: 24px;

    &::before {
      content: '';
      position: absolute;
      left: 6px;
      top: 12px;
      bottom: 0;
      width: 2px;
      background: var(--color-glass-border);
      border-radius: var(--rounded-pill);
    }
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--spacing-xl);

    &:last-child { margin-bottom: 0; }
  }

  .timeline-dot {
    position: absolute;
    left: -21px;
    top: 20px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 8px var(--color-primary-glow);
  }

  .timeline-card {
    border-radius: var(--rounded-xl);
    padding: var(--spacing-xl);
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-lg);
  }

  .exp-role {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 4px 0;
  }

  .exp-org {
    font-size: 13px;
    color: var(--color-ink-secondary);
    margin: 0;
  }

  .exp-date {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    background: rgba(83, 58, 253, 0.1);
    border: 1px solid rgba(83, 58, 253, 0.2);
    color: var(--color-primary);
    border-radius: var(--rounded-pill);
    white-space: nowrap;
  }

  .exp-bullets {
    margin: 0 0 var(--spacing-lg) 0;
    padding-left: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: 6px;

    li {
      font-size: 13px;
      color: var(--color-ink-secondary);
      line-height: 1.6;
    }
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    background: rgba(83, 58, 253, 0.1);
    border: 1px solid rgba(83, 58, 253, 0.2);
    color: var(--color-primary);
    border-radius: var(--rounded-pill);
  }
</style>
