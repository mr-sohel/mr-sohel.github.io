---
import { instructor } from '../data/profile';
---

<section id="experience" class="block card">
  <span class="eyebrow">Experience</span>
  <h2 class="section-title">Teaching</h2>

  <h3 class="role">{instructor.role}</h3>
  <p class="org">
    <a href={instructor.orgHref} target="_blank" rel="noopener noreferrer">{instructor.org}</a>
  </p>
  <p class="dates label">
    <time datetime={instructor.start}>August 2024</time> – <time datetime={instructor.end}>April 2026</time>
  </p>

  <ul class="points">
    {instructor.points.map((point) => <li>{point}</li>)}
  </ul>
</section>

<style lang="scss">
  .block {
    padding: var(--spacing-xxl);
  }

  .section-title {
    margin-bottom: var(--spacing-xl);
  }

  .role {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .org {
    margin: 2px 0 0;
    font-weight: 500;
  }

  .dates {
    margin: var(--spacing-xs) 0 var(--spacing-lg);
    color: var(--color-ink-mute);
  }

  .points {
    display: grid;
    gap: var(--spacing-md);
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-secondary);

    li {
      position: relative;
      padding-left: var(--spacing-lg);

      &::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.7em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-primary);
      }
    }
  }
</style>
