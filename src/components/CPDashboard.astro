---
const achievements = [
  { year: "2025", title: "Meta Hacker Cup", desc: "Round 2 Qualifier (Top 13k)", link: "#" },
  { year: "2025", title: "UIU Inter University Programming Contest", desc: "UIUIUPC 2025 Participant", link: "#" },
  { year: "2024", title: "ICPC Asia Dhaka Regional Contest", desc: "Ranked 157th (Team: BUBT_Mudbloods)", link: "#" },
  { year: "2024", title: "UAP Inter University Programming Contest", desc: "2nd Runner-up among 68 teams", link: "#" },
  { year: "2024", title: "BUBT Intra University Programming Contest", desc: "Champion · 2022, 2024", link: "#" },
  { year: "2023", title: "ICPC Asia Dhaka Regional Contest", desc: "Honorable Mention", link: "#" },
  { year: "2018", title: "BACS High School Programming Contest", desc: "2nd Runner-up, Rajshahi Region", link: "#" },
  { year: "2018", title: "SPI Tech Festival", desc: "Champion", link: "#" }
];
---

<section id="cp" class="section">
  <div class="section-inner">
    <span class="section-title-sm">Competitive Programming</span>
    <h2 class="section-title">Rated across 3 platforms · 1500+ problems</h2>

    <div class="cp-platforms reveal-group">
      <a href="https://codeforces.com/profile/mr_sohel" target="_blank" rel="noopener noreferrer" class="cp-card reveal">
        <div class="cp-platform-name">Codeforces</div>
        <div class="cp-rating cp-rating--cf">1422</div>
        <div class="cp-rank">Specialist</div>
      </a>
      <a href="https://leetcode.com/u/mr_sohel/" target="_blank" rel="noopener noreferrer" class="cp-card reveal">
        <div class="cp-platform-name">LeetCode</div>
        <div class="cp-rating cp-rating--lc">1653</div>
        <div class="cp-rank">Knight · Top 5%</div>
      </a>
      <a href="https://www.codechef.com/users/mr_sohel" target="_blank" rel="noopener noreferrer" class="cp-card reveal">
        <div class="cp-platform-name">CodeChef</div>
        <div class="cp-rating cp-rating--cc">1623</div>
        <div class="cp-rank">3★ Rated</div>
      </a>
    </div>

    <div class="cp-cta reveal">
      <a href="https://codolio.com/profile/mr_sohel" target="_blank" rel="noopener noreferrer" class="cp-cta-link">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        View full CP profile on Codolio
      </a>
    </div>

    <div class="cp-achievements reveal">
      <h3 class="cp-ach-title">Contest Highlights &amp; Awards</h3>
      <ul class="cp-ach-list">
        {achievements.map((ach) => (
          <li class="cp-ach-item">
            <span class="cp-ach-year">{ach.year}</span>
            <span><strong>{ach.title}</strong> — {ach.desc}</span>
            {ach.link && ach.link !== "#" && (
              <a href={ach.link} class="cp-ach-link" title="View standings">Standing</a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style lang="scss">
  .cp-platforms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xxl);

    @media (max-width: 820px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
    }
  }

  .cp-platforms.reveal-group {
    > .cp-card:nth-child(1) { transition-delay: 0.12s; }
    > .cp-card:nth-child(2) { transition-delay: 0.24s; }
    > .cp-card:nth-child(3) { transition-delay: 0.36s; }
  }

  .cp-card {
    display: block;
    text-decoration: none;
    padding: var(--spacing-xl);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-tint) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-xl);
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;

    &:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    @media (max-width: 480px) {
      padding: var(--spacing-lg);
    }
  }

  .cp-platform-name {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-ink-mute);
    margin-bottom: var(--spacing-sm);
  }

  .cp-rating {
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  /* Platform-specific rating colours — light and dark mode aware */
  .cp-rating--cf {
    --_rating-color: #3b82f6;
    color: var(--_rating-color);
  }
  .cp-rating--lc {
    --_rating-color: #f59e0b;
    color: var(--_rating-color);
  }
  .cp-rating--cc {
    --_rating-color: #10b981;
    color: var(--_rating-color);
  }

  :global([data-theme="dark"]) .cp-rating--cf { --_rating-color: #60a5fa; }
  :global([data-theme="dark"]) .cp-rating--lc { --_rating-color: #fbbf24; }
  :global([data-theme="dark"]) .cp-rating--cc { --_rating-color: #34d399; }

  .cp-rank {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-secondary);
    margin-top: 4px;
  }

  .cp-cta {
    text-align: center;
    margin-bottom: var(--spacing-xxl);
  }

  .cp-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-secondary);
    text-decoration: none;
    padding: 10px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-pill);
    touch-action: manipulation;
    transition: color 0.2s ease, border-color 0.2s ease;

    &:hover {
      color: var(--color-primary);
      border-color: var(--color-primary);
    }
  }

  .cp-achievements {
    padding: var(--spacing-xxl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-xl);
    box-shadow: var(--shadow-sm);

    @media (max-width: 480px) {
      padding: var(--spacing-xl);
    }
  }

  .cp-ach-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 var(--spacing-lg);
  }

  .cp-ach-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .cp-ach-item {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-md);
    font-size: 14px;
    color: var(--color-ink-secondary);
    line-height: 1.5;

    strong { color: var(--color-ink); font-weight: 600; }

    > span:not(.cp-ach-year):not(.cp-ach-link) {
      min-width: 0;
      overflow-wrap: break-word;
    }

    @media (max-width: 640px) {
      flex-wrap: wrap;
      row-gap: 6px;
    }
  }

  .cp-ach-year {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
    min-width: 50px;

    @media (max-width: 640px) {
      width: 100%;
    }
  }

  .cp-ach-link {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-ink-mute);
    text-decoration: none;
    padding: 2px 8px;
    border: 1px solid var(--color-border-light);
    border-radius: var(--rounded-pill);
    touch-action: manipulation;
    transition: color 0.2s ease, border-color 0.2s ease;

    &:hover {
      color: var(--color-primary);
      border-color: var(--color-primary);
    }

    @media (max-width: 640px) {
      padding: 6px 10px;
    }
  }
</style>
