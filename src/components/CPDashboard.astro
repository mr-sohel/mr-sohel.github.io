---
import Balloon from './Balloon.astro';
import { levelLabels, links, person, ratings, results, totals, type Level } from '../data/profile';

const levels = Object.entries(levelLabels) as [Level, string][];
let balloonIndex = 0;
---

<section id="cp" class="board">
  <div class="section-inner">
    <header class="board-head">
      <h2 class="section-title">Standings</h2>
      <p>
        {totals.problems} algorithmic problems solved and {totals.contests} online contests.
        <a href={links.codolio} target="_blank" rel="noopener noreferrer">See all stats on Codolio</a>
      </p>
    </header>

    <ul class="ratings">
      {ratings.map((r) => (
        <li>
          <a href={r.href} target="_blank" rel="noopener noreferrer">
            <span class="rating-platform label">{r.platform}</span>
            <span class="rating-value">{r.rating}</span>
            <span class="rating-standing label">{r.standing}</span>
          </a>
        </li>
      ))}
    </ul>

    <table class="standings" data-standings>
      <caption class="sr-only">Contest results</caption>
      <thead class="label">
        <tr>
          <th scope="col"><span class="sr-only">Balloons</span></th>
          <th scope="col">Contest</th>
          <th scope="col">Result</th>
          <th scope="col">Field</th>
          <th scope="col"><span class="sr-only">Proof</span></th>
        </tr>
      </thead>
      <tbody>
        {results.map((row) => (
          <tr>
            <td class="cell-balloons">
              {Array.from({ length: row.balloons }, () => (
                <span class="rise" style={`--i: ${balloonIndex++};`}>
                  <Balloon level={row.level!} size={24} />
                </span>
              ))}
            </td>
            <th scope="row" class="cell-event">{row.event}</th>
            <td class="cell-result">{row.result}</td>
            <td class="cell-field label">{row.field}</td>
            <td class="cell-proof label">
              {row.proof && (
                <a href={row.proof.href} target="_blank" rel="noopener noreferrer">{row.proof.label}</a>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="board-foot">
      <p>
        At ICPC contests, a team gets a balloon for each problem it solves. Here, each balloon marks
        one result. ICPC and university results are with team {person.team}.{' '}
        <a href={links.icpc} target="_blank" rel="noopener noreferrer">View my ICPC profile</a>
      </p>
      <ul class="legend label">
        {levels.map(([level, name]) => (
          <li><Balloon level={level} size={13} /> {name}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const standings = document.querySelector('[data-standings]');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (standings && motionOk && 'IntersectionObserver' in window) {
    standings.classList.add('will-rise');
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        standings.classList.add('risen');
        observer.disconnect();
      }
    }, { threshold: 0.25 });
    observer.observe(standings);
  }
</script>

<style lang="scss">
  .board {
    --focus: var(--board-ink);
    padding: var(--spacing-massive) var(--gutter);
    background: var(--board-bg);
    color: var(--board-ink);

    a {
      color: var(--board-ink);

      &:hover {
        color: var(--balloon-intra);
      }
    }
  }

  .board-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-lg) var(--spacing-huge);
    align-items: end;
    margin-bottom: var(--spacing-huge);

    p {
      margin: 0;
      font-size: 1.125rem;
      color: var(--board-mute);

      a {
        display: inline-block;
        font-weight: 500;
      }
    }
  }

  .ratings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--board-line);
    border-radius: var(--rounded-xl);
    margin-bottom: var(--spacing-huge);

    li + li {
      border-left: 1px solid var(--board-line);
    }

    a {
      display: flex;
      flex-direction: column;
      padding: var(--spacing-xl);
      text-decoration: none;
      height: 100%;
      transition: background-color 0.15s ease;

      &:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--board-ink);
      }
    }
  }

  .rating-platform,
  .rating-standing {
    color: var(--board-mute);
  }

  .rating-value {
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    margin: var(--spacing-xs) 0;
  }

  .standings {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--spacing-xxl);

    thead th {
      padding: 0 var(--spacing-md) var(--spacing-sm);
      text-align: left;
      font-weight: 500;
      color: var(--board-mute);
    }

    tbody tr {
      border-top: 1px solid var(--board-line);
    }

    tbody td,
    tbody th {
      padding: var(--spacing-lg) var(--spacing-md);
      text-align: left;
      vertical-align: middle;
    }
  }

  .cell-balloons {
    width: 84px;
    padding-left: 0 !important;
    white-space: nowrap;
    color: var(--board-mute);
  }

  .cell-event {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .cell-result {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cell-field {
    color: var(--board-mute);
    white-space: nowrap;
  }

  .cell-proof {
    text-align: right !important;
    padding-right: 0 !important;
    white-space: nowrap;
  }

  /* Balloons rise into their rows once, the first time the table is seen */
  .rise {
    display: inline-block;
    margin-right: 4px;
  }

  .will-rise .rise {
    opacity: 0;
    transform: translateY(44px);
  }

  .will-rise.risen .rise {
    opacity: 1;
    transform: none;
    transition: transform 0.9s cubic-bezier(0.2, 0.9, 0.25, 1.1), opacity 0.3s ease;
    transition-delay: calc(var(--i) * 110ms);
  }

  .board-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--spacing-lg) var(--spacing-huge);
    align-items: start;

    p {
      margin: 0;
      max-width: 40em;
      font-size: 0.9375rem;
      color: var(--board-mute);
    }
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: var(--spacing-xs) var(--spacing-xl);
    color: var(--board-mute);

    li {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      white-space: nowrap;
    }
  }

  @media (max-width: 860px) {
    .board {
      padding-block: 64px;
    }

    .board-head,
    .board-foot {
      grid-template-columns: minmax(0, 1fr);
    }

    .standings {
      thead {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }

      tbody tr {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          'event event'
          'result balloons'
          'field proof';
        gap: 2px var(--spacing-md);
        padding: var(--spacing-lg) 0;
      }

      tbody td,
      tbody th {
        padding: 0 !important;
      }
    }

    .cell-event { grid-area: event; }
    .cell-result { grid-area: result; white-space: normal; }
    .cell-field { grid-area: field; }
    .cell-proof { grid-area: proof; }

    .cell-balloons {
      grid-area: balloons;
      width: auto;
      text-align: right;
    }
  }

  @media (max-width: 620px) {
    .ratings {
      grid-template-columns: minmax(0, 1fr);

      li + li {
        border-left: 0;
        border-top: 1px solid var(--board-line);
      }

      a {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          'platform value'
          'standing value';
        align-items: center;
        padding: var(--spacing-md) var(--spacing-lg);
      }
    }

    .rating-platform { grid-area: platform; align-self: end; }
    .rating-standing { grid-area: standing; align-self: start; }

    .rating-value {
      grid-area: value;
      font-size: 3.5rem;
      margin: 0;
    }
  }

  @media (max-width: 400px) {
    .legend {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
