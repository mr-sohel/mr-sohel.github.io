---
---

<section id="cp" class="content-section bordered-top">
  <div class="section-heading reveal">
    <h2>Competitive Programming</h2>
    <div class="heading-bar"></div>
  </div>

  <!-- Platform rating cards -->
  <div class="cp-grid reveal-group">
    <div class="cp-card reveal">
      <div class="cp-platform">Codeforces</div>
      <div class="cp-rating" style="color: #4299e1">1619</div>
      <div class="cp-rank">Specialist</div>
    </div>
    <div class="cp-card reveal">
      <div class="cp-platform">LeetCode</div>
      <div class="cp-rating" style="color: #f6ad55">Knight</div>
      <div class="cp-rank">Top 5%</div>
    </div>
    <div class="cp-card reveal">
      <div class="cp-platform">CodeChef</div>
      <div class="cp-rating" style="color: #68d391">1619</div>
      <div class="cp-rank">3★ Rated</div>
    </div>
  </div>

  <!-- Achievements -->
  <div class="cp-achievements reveal">
    <h3 class="ach-title">Notable Achievements</h3>
    <ul class="ach-list">
      <li class="ach-item reveal">
        <span class="ach-icon" aria-hidden="true">🏆</span>
        <div>
          <strong>ICPC Asia Dhaka Regional 2023</strong> — Qualified as Regionalist (3× consecutive)
        </div>
      </li>
      <li class="ach-item reveal">
        <span class="ach-icon" aria-hidden="true">🥇</span>
        <div>
          <strong>BUBT Intra University Programming Contest</strong> — Champion
        </div>
      </li>
      <li class="ach-item reveal">
        <span class="ach-icon" aria-hidden="true">📚</span>
        <div>
          <strong>CP Instructor</strong> — Taught competitive programming to 50+ students at BUBT
        </div>
      </li>
      <li class="ach-item reveal">
        <span class="ach-icon" aria-hidden="true">💻</span>
        <div>
          <strong>1500+ problems</strong> solved across Codeforces, LeetCode, CodeChef, AtCoder, Toph
        </div>
      </li>
    </ul>
  </div>
</section>

<style lang="scss">
  .content-section {
    padding: var(--spacing-xxl);
    @media (max-width: 768px) { padding: var(--spacing-xl) var(--spacing-lg); }
  }
  .bordered-top { border-top: 1px solid var(--color-glass-border); }

  .cp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xxl);
    @media (max-width: 640px) { grid-template-columns: 1fr; }
  }

  .cp-card {
    background: var(--color-glass);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--rounded-xl);
    padding: var(--spacing-xl);
    text-align: center;
    transition: border-color 0.2s ease, transform 0.2s ease;

    &:hover { border-color: rgba(83,58,253,0.3); transform: translateY(-2px); }
  }

  .cp-platform {
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-ink-mute);
    margin-bottom: var(--spacing-sm);
  }

  .cp-rating {
    font-size: 32px;
    font-weight: 900;
    font-feature-settings: "tnum" on;
    line-height: 1.1;
  }

  .cp-rank {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-ink-secondary);
    margin-top: 4px;
  }

  .cp-achievements {
    background: var(--color-glass);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--rounded-xl);
    padding: var(--spacing-xl);
  }

  .ach-title {
    font-size: 14px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-ink-secondary);
    margin: 0 0 var(--spacing-lg) 0;
  }

  .ach-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .ach-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    font-size: 14px;
    color: var(--color-ink-secondary);
    line-height: 1.5;

    strong { color: var(--color-ink); }
  }

  .ach-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
</style>
