---
import Balloon from './Balloon.astro';
import IconExternal from './icons/IconExternal.astro';
import { levelLabels, links, person, ratings, results, totals, type Level } from '../data/profile';

const levels = Object.entries(levelLabels) as [Level, string][];
let balloonIndex = 0;
---

<section id="cp" class="section section-alt">
  <div class="section-inner">
    <header class="board-head">
      <div>
        <span class="eyebrow">Competitive programming</span>
        <h2 class="section-title">Problem-solving record</h2>
      </div>
      <p class="section-lede">
        {totals.problems} algorithmic problems solved across {totals.contests} online contests. The same
        habits I bring to backend work: read the constraints, pick the right data structure, test the edge cases.{' '}
        <a href={links.codolio} target="_blank" rel="noopener noreferrer">See all stats on Codolio</a>
      </p>
    </header>

    <ul class="ratings">
      {ratings.map((r) => (
        <li>
          <a class="card" href={r.href} target="_blank" rel="noopener noreferrer">
            <span class="rating-top">
              <span class="rating-platform label">{r.platform}</span>
              <IconExternal width="14" height="14" />
            </span>
            <span class="rating-value">{r.rating}</span>
            <span class="rating-standing label">{r.standing}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="table-card card">
      <table class="standings" data-standings>
        <caption class="sr-only">Contest results</caption>
        <thead class="label">
          <tr>
            <th scope="col"><span class="sr-only">Level</span></th>
            <th scope="col">Contest</th>
            <th scope="col">Result</th>
            <th scope="col">Field</th>
            <th scope="col"><span class="sr-only">Proof</span></th>
          </tr>
        </thead>
        <tbody>
          {results.map((row) => (
            <tr>
              <td class="cell-balloons">
                {Array.from({ length: row.balloons }, () => (
                  <span class="rise" style={`--i: ${balloonIndex++};`}>
                    <Balloon level={row.level!} size={22} />
                  </span>
                ))}
              </td>
              <th scope="row" class="cell-event">{row.event}</th>
              <td class="cell-result">{row.result}</td>
              <td class="cell-field label">{row.field}</td>
              <td class="cell-proof label">
                {row.proof && (
                  <a href={row.proof.href} target="_blank" rel="noopener noreferrer">{row.proof.label}</a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="board-foot">
      <p>
        At ICPC contests, a team gets a balloon for each problem it solves. Here, each balloon marks
        one result. ICPC and university results are with team {person.team}.{' '}
        <a href={links.icpc} target="_blank" rel="noopener noreferrer">View my ICPC profile</a>
      </p>
      <ul class="legend label">
        {levels.map(([level, name]) => (
          <li><Balloon level={level} size={12} /> {name}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const standings = document.querySelector('[data-standings]');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (standings && motionOk && 'IntersectionObserver' in window) {
    standings.classList.add('will-rise');
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        standings.classList.add('risen');
        observer.disconnect();
      }
    }, { threshold: 0.25 });
    observer.observe(standings);
  }
</script>

<style lang="scss">
  .board-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--spacing-lg) var(--spacing-huge);
    align-items: end;
    margin-bottom: var(--spacing-huge);

    .section-lede {
      margin: 0;
    }
  }

  .ratings {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);

    a {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: var(--spacing-xl);
      color: var(--color-ink);
      text-decoration: none;
      transition: border-color 0.15s ease, transform 0.15s ease;

      &:hover {
        border-color: var(--color-primary);
        color: var(--color-ink);
        transform: translateY(-2px);
      }
    }
  }

  .rating-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-ink-mute);
  }

  .rating-value {
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    margin: var(--spacing-md) 0 var(--spacing-xs);
  }

  .rating-standing {
    color: var(--color-up);
  }

  .table-card {
    padding: var(--spacing-xs) var(--spacing-xl);
    margin-bottom: var(--spacing-xl);
    overflow-x: auto;
  }

  .standings {
    width: 100%;
    border-collapse: collapse;

    thead th {
      padding: var(--spacing-md) var(--spacing-md) var(--spacing-sm);
      text-align: left;
      font-weight: 500;
      color: var(--color-ink-mute);
    }

    tbody tr {
      border-top: 1px solid var(--color-border);
    }

    tbody td,
    tbody th {
      padding: var(--spacing-md);
      text-align: left;
      vertical-align: middle;
    }
  }

  .cell-balloons {
    width: 64px;
    padding-left: 0 !important;
    white-space: nowrap;
    color: var(--color-ink-mute);
  }

  .cell-event {
    font-weight: 500;
  }

  .cell-result {
    font-weight: 600;
    white-space: nowrap;
  }

  .cell-field {
    color: var(--color-ink-mute);
    white-space: nowrap;
  }

  .cell-proof {
    text-align: right !important;
    padding-right: 0 !important;
    white-space: nowrap;
  }

  /* Balloons rise into their rows once, the first time the table is seen */
  .rise {
    display: inline-block;
    margin-right: 4px;
  }

  .will-rise .rise {
    opacity: 0;
    transform: translateY(32px);
  }

  .will-rise.risen .rise {
    opacity: 1;
    transform: none;
    transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.25, 1.1), opacity 0.3s ease;
    transition-delay: calc(var(--i) * 100ms);
  }

  .board-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--spacing-lg) var(--spacing-huge);
    align-items: start;

    p {
      margin: 0;
      max-width: 40em;
      font-size: 0.9375rem;
      color: var(--color-ink-mute);
    }
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: var(--spacing-xs) var(--spacing-xl);
    color: var(--color-ink-mute);

    li {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      white-space: nowrap;
    }
  }

  @media (max-width: 860px) {
    .board-head,
    .board-foot {
      grid-template-columns: minmax(0, 1fr);
    }

    .ratings {
      grid-template-columns: minmax(0, 1fr);

      a {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          'top value'
          'standing value';
        align-items: center;
        padding: var(--spacing-md) var(--spacing-lg);
      }
    }

    .rating-top { grid-area: top; align-self: end; }
    .rating-standing { grid-area: standing; align-self: start; }

    .rating-value {
      grid-area: value;
      font-size: 2.25rem;
      margin: 0;
    }

    .table-card {
      padding-inline: var(--spacing-lg);
    }

    .standings {
      thead {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }

      tbody tr {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
          'event event'
          'result balloons'
          'field proof';
        gap: 2px var(--spacing-md);
        padding: var(--spacing-lg) 0;
      }

      tbody tr:first-child {
        border-top: 0;
      }

      tbody td,
      tbody th {
        padding: 0 !important;
      }
    }

    .cell-event { grid-area: event; }
    .cell-result { grid-area: result; white-space: normal; }
    .cell-field { grid-area: field; }
    .cell-proof { grid-area: proof; }

    .cell-balloons {
      grid-area: balloons;
      width: auto;
      text-align: right;
    }
  }

  @media (max-width: 400px) {
    .legend {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
