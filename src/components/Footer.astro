---
import { person } from '../data/profile';
---

<footer class="footer">
  <p class="label">© 2026 {person.name}</p>
  <p class="label">Built with Astro. Deployed on GitHub Pages.</p>
</footer>

<style lang="scss">
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--spacing-xs) var(--spacing-xl);
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: var(--spacing-xl) var(--gutter);
    color: var(--color-ink-mute);

    p {
      margin: 0;
    }
  }
</style>
