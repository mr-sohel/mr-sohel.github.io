---
import { person } from '../data/profile';

const sections = [
  { id: 'about', label: 'About' },
  { id: 'projects', label: 'Project' },
  { id: 'cp', label: 'Standings' },
  { id: 'skills', label: 'Skills' },
  { id: 'experience', label: 'Teaching' },
  { id: 'education', label: 'Education' },
  { id: 'contact', label: 'Contact' },
];
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="#hero" class="nav-logo" aria-label={`${person.name}, back to top`}>SR</a>

    <div class="nav-links">
      {sections.map((s) => (
        <a href={`#${s.id}`} class="nav-link">{s.label}</a>
      ))}
    </div>

    <div class="nav-right">
      <a href={person.resume} download={person.resumeFilename} class="nav-cv-btn">Download resume</a>

      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
        <svg class="sun-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="moon-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </button>
    </div>
  </div>
</nav>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true" inert>
  <div class="mobile-menu-backdrop"></div>
  <nav class="mobile-menu-panel" aria-label="Mobile navigation">
    <div class="mobile-header">
      <span class="mobile-logo">SR</span>
      <button id="mobile-close-btn" class="mobile-close-btn" aria-label="Close menu">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="mobile-nav-links">
      {sections.map((s) => (
        <a href={`#${s.id}`} class="mobile-link" data-section={s.id}>{s.label}</a>
      ))}
    </div>
    <div class="mobile-menu-footer">
      <a href={person.resume} download={person.resumeFilename} class="mobile-cv-btn">Download resume</a>
    </div>
  </nav>
</div>

<script>
  import { initNav } from "./nav.ts";
  initNav();
</script>

<style lang="scss">
  .nav {
    --focus: var(--on-field);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: var(--spacing-md) var(--gutter);
    padding-top: calc(var(--spacing-md) + env(safe-area-inset-top, 0px));
    color: var(--on-field);
    transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;

    &.scrolled {
      --focus: var(--color-primary);
      background: var(--color-surface);
      color: var(--color-ink);
      box-shadow: 0 1px 0 var(--color-border);
    }
  }

  .nav-inner {
    max-width: var(--measure);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xl);
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
    color: inherit;
    text-decoration: none;
  }

  .nav-links {
    display: none;

    @media (min-width: 1024px) {
      display: flex;
      gap: var(--spacing-xl);
    }
  }

  .nav-link {
    position: relative;
    padding: 4px 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: inherit;
    text-decoration: none;

    &::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 2px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.15s ease;
    }

    &:hover,
    &.active {
      color: inherit;

      &::after {
        transform: scaleX(1);
      }
    }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .nav-cv-btn {
    display: none;
    align-items: center;
    min-height: 40px;
    padding: 8px 16px;
    font-size: 0.875rem;
    font-weight: 600;
    color: inherit;
    border: 1.5px solid currentColor;
    border-radius: var(--rounded-pill);
    text-decoration: none;
    transition: background-color 0.15s ease;

    &:hover {
      color: inherit;
      background: rgba(127, 127, 160, 0.18);
    }

    @media (min-width: 560px) {
      display: inline-flex;
    }
  }

  .theme-toggle,
  .mobile-menu-btn,
  .mobile-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--rounded-md);
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;

    &:hover {
      background: rgba(127, 127, 160, 0.18);
    }
  }

  .sun-icon { display: none; }
  .moon-icon { display: block; }

  :global([data-theme="dark"]) .sun-icon { display: block; }
  :global([data-theme="dark"]) .moon-icon { display: none; }

  .mobile-menu-btn {
    margin-right: -10px;

    @media (min-width: 1024px) {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;

    @media (min-width: 1024px) {
      display: none;
    }
  }

  .mobile-menu[aria-hidden="false"] {
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23, 18, 58, 0.6);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .mobile-menu[aria-hidden="false"] .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 300px;
    max-width: 85vw;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    color: var(--color-ink);
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-menu[aria-hidden="false"] .mobile-menu-panel {
    transform: translateX(0);
  }

  .mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-md) var(--spacing-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-logo {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
  }

  .mobile-close-btn {
    margin-right: -10px;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--spacing-sm) 0;
    overflow-y: auto;
  }

  .mobile-link {
    padding: 14px var(--spacing-xl);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;

    &:hover {
      color: var(--color-ink);
      background: var(--color-surface-hover);
    }

    &.active {
      color: var(--color-primary);
    }
  }

  .mobile-menu-footer {
    padding: var(--spacing-lg) var(--spacing-xl);
    padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
  }

  .mobile-cv-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 600;
    border-radius: var(--rounded-pill);
    text-decoration: none;

    &:hover {
      background: var(--color-primary-deep);
      color: var(--color-on-primary);
    }
  }
</style>
