---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`gradient-mesh ${className}`.trim()}>
  <!-- Fallback CSS gradient, would ideally be overlaid with a noise texture or WebP mesh -->
  <div class="mesh-overlay"></div>
</div>

<style lang="scss">
  .gradient-mesh {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 70vh; /* Occupies upper portion */
    min-height: 500px;
    z-index: -1;
    overflow: hidden;
    
    /* Stripi-inspired gradient stops */
    background: linear-gradient(
      135deg,
      var(--color-canvas-cream) 0%,
      #f5b682 20%, /* Warm orange */
      #c494f8 45%, /* Lavender */
      var(--color-primary) 75%, /* Indigo */
      var(--color-ruby, #ea2261) 100% /* Ruby pink */
    );
    
    /* Make it softer */
    opacity: 0.8;
  }

  /* Fade out at the bottom into the canvas color */
  .mesh-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.4) 50%,
      var(--color-canvas) 100%
    );
    
    /* Dark mode override via data attribute is handled in global.scss, 
       but we can use css variables here for smooth transition */
  }

  :global([data-theme="dark"]) .mesh-overlay {
    background: linear-gradient(
      to bottom,
      rgba(13, 17, 23, 0) 0%,
      rgba(13, 17, 23, 0.6) 60%,
      var(--color-canvas) 100%
    );
  }
</style>
