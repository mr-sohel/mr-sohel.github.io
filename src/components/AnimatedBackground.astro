<!-- Animated dark background: moving grid + 3 blur orbs + scanline overlay -->
<div class="bg-canvas" aria-hidden="true">
  <!-- Moving grid -->
  <div class="bg-grid"></div>

  <!-- Scanline texture -->
  <div class="bg-scanlines"></div>

  <!-- Blur orbs -->
  <div class="orb orb-indigo"></div>
  <div class="orb orb-purple"></div>
  <div class="orb orb-cyan"></div>
</div>

<style lang="scss">
  .bg-canvas {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* Moving grid */
  .bg-grid {
    position: absolute;
    inset: -10%;
    background-image:
      linear-gradient(to right, rgba(71, 85, 105, 0.4) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(71, 85, 105, 0.4) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 90%);
    animation: grid-move 20s linear infinite;
  }

  :global([data-theme="light"]) .bg-grid {
    background-image:
      linear-gradient(to right, rgba(100, 116, 139, 0.15) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(100, 116, 139, 0.15) 1px, transparent 1px);
  }

  /* Scanlines */
  .bg-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.03) 2px,
      rgba(0, 0, 0, 0.03) 4px
    );
    opacity: 0.4;
  }

  /* Orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    animation: orb-pulse 8s ease-in-out infinite;
    mix-blend-mode: screen;
  }

  .orb-indigo {
    top: -10%;
    left: -10%;
    width: 55vw;
    height: 55vw;
    background: radial-gradient(circle, rgba(83, 58, 253, 0.18) 0%, transparent 70%);
    animation-duration: 10s;
  }

  .orb-purple {
    bottom: -10%;
    right: -10%;
    width: 65vw;
    height: 65vw;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.12) 0%, transparent 70%);
    animation-duration: 13s;
    animation-delay: 3s;
  }

  .orb-cyan {
    top: 30%;
    left: 40%;
    width: 40vw;
    height: 40vw;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.08) 0%, transparent 70%);
    animation-duration: 11s;
    animation-delay: 5s;
  }

  :global([data-theme="light"]) .orb {
    opacity: 0.3;
  }
</style>
