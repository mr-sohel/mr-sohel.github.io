---
import IconGithub from './icons/IconGithub.astro';
import IconExternal from './icons/IconExternal.astro';
import { projects } from '../data/profile';
---

<section id="projects" class="section">
  <div class="section-inner">
    <header class="work-head">
      <span class="eyebrow">Projects</span>
      <h2 class="section-title">What I'm building</h2>
    </header>

    <ul class="project-grid">
      {projects.map((project) => (
        <li class:list={['project', 'card', { 'is-placeholder': project.placeholder }]}>
          <div class="project-top">
            <h3 class="project-name">{project.name}</h3>
            {project.placeholder && <span class="badge label">In progress</span>}
          </div>

          <p class="project-summary">{project.summary}</p>

          {project.role && <p class="project-role label">{project.role}</p>}

          {project.highlights && project.highlights.length > 0 && (
            <ul class="highlights">
              {project.highlights.map((item) => (
                <li>
                  <h4>{item.title}</h4>
                  <p>{item.body}</p>
                </li>
              ))}
            </ul>
          )}

          {project.stack.length > 0 && (
            <ul class="stack label" aria-label="Stack">
              {project.stack.map((item) => <li>{item}</li>)}
            </ul>
          )}

          {(project.repo || project.demo) && (
            <p class="project-links">
              {project.repo && (
                <a href={project.repo} target="_blank" rel="noopener noreferrer">
                  <IconGithub width="18" height="18" /> Source on GitHub
                </a>
              )}
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noopener noreferrer">
                  <IconExternal width="16" height="16" /> Live demo
                </a>
              )}
            </p>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style lang="scss">
  .work-head {
    margin-bottom: var(--spacing-xxl);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-lg);
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-xl);
    min-height: 220px;
  }

  .is-placeholder {
    background: var(--color-subtle);
    border-style: dashed;
    border-color: var(--color-border-strong);
  }

  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
  }

  .project-name {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .badge {
    flex-shrink: 0;
    padding: 2px 10px;
    color: var(--color-ink-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-pill);
  }

  .project-summary {
    margin: 0;
    color: var(--color-ink-secondary);
  }

  .project-role {
    margin: 0;
    color: var(--color-ink-mute);
  }

  .highlights {
    display: grid;
    gap: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);

    h4 {
      margin: 0 0 2px;
      font-size: 1rem;
      font-weight: 600;
    }

    p {
      margin: 0;
      font-size: 0.9375rem;
      color: var(--color-ink-secondary);
    }
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: auto;

    li {
      padding: 4px 10px;
      color: var(--color-ink-secondary);
      background: var(--color-subtle);
      border: 1px solid var(--color-border);
      border-radius: var(--rounded-sm);
    }
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xl);
    margin: 0;

    a {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-sm);
      min-height: 44px;
      font-weight: 600;
    }
  }

  @media (max-width: 760px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
