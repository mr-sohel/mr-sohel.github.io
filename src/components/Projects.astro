---
import IconExternal from './icons/IconExternal.astro';
import IconGithub from './icons/IconGithub.astro';

const projects = [
  {
    image: "/images/online-judge.webp",
    alt: "Online Judge System built with ASP.NET Core and Docker showing code submission interface",
    status: "In Progress",
    statusClass: "status-progress",
    tags: ["C#", "ASP.NET Core", "Docker", "PostgreSQL", "RabbitMQ"],
    title: "Online Judge System",
    desc: "A containerized competitive programming judge with Docker-sandboxed code execution, RabbitMQ async job processing, and support for C++, Python, and Java — built to the same core architecture as Codeforces and LeetCode.",
    metrics: [
      "<strong>10+ req/s</strong> under concurrent load",
      "<strong>&lt;500ms</strong> avg verdict",
      "<strong>3 languages</strong> supported"
    ],
    demoLink: "https://online-judge-demo.vercel.app",
    repoLink: "https://github.com/mr-sohel/online-judge-system"
  },
  {
    image: "/images/fruit-quality.webp",
    alt: "Real-Time Fruit Quality Detection system using YOLOv8 showing fresh vs rotten fruit classification",
    status: "Completed",
    statusClass: "status-done",
    tags: ["Python", "YOLOv8", "FastAPI", "ESP32-CAM"],
    title: "Real-Time Fruit Quality Detection",
    desc: "End-to-end IoT + ML system that detects fresh vs rotten fruit using a $5 ESP32-CAM and a cloud-hosted YOLOv8 model streamed over WiFi.",
    metrics: [
      "<strong>98.97%</strong> mAP@50",
      "<strong>80%</strong> faster vs YOLOv8n baseline",
      "<strong>3s</strong> end-to-end over WiFi"
    ],
    demoLink: "https://fruit-quality-demo.vercel.app",
    repoLink: "https://github.com/mr-sohel/fruit-quality-detection"
  },
  {
    image: "/images/autism-fer.webp",
    alt: "Facial Emotion Recognition for Autism using Swin Transformer deep learning model",
    status: "Completed",
    statusClass: "status-done",
    tags: ["Python", "PyTorch", "Swin Transformer", "Grad-CAM"],
    title: "Facial Emotion Recognition for Autism",
    desc: "Swin Transformer model classifying 7 facial emotions in autistic individuals — outperforming 14 published baselines. Undergraduate thesis project.",
    metrics: [
      "<strong>89%</strong> Accuracy",
      "<strong>7</strong> Emotion classes",
      "<strong>14</strong> Baselines beaten"
    ],
    demoLink: "https://fer-autism-demo.vercel.app",
    repoLink: "https://github.com/mr-sohel/fer-autism"
  }
];
---
<section id="projects" class="section section-alt">
  <div class="section-inner">
    <span class="section-title-sm">Projects</span>
    <h2 class="section-title">What I've built</h2>

    <div class="projects-grid">
      {projects.map(project => (
        <article class="project-card reveal">
          <div class="project-media">
            <picture>
              <source srcset={project.image} type="image/webp" />
              <img src={project.image} alt={project.alt} width="800" height="400" loading="lazy" decoding="async" />
            </picture>
            <span class={`project-status ${project.statusClass}`}>{project.status}</span>
          </div>
          <div class="project-body">
            <div class="project-tags">
              {project.tags.map(tag => (
                <span class="ptag">{tag}</span>
              ))}
            </div>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.desc}</p>
            <div class="project-metrics">
              {project.metrics.map(metric => (
                <span class="pmetric" set:html={metric}></span>
              ))}
            </div>
            <div class="project-links">
              <a href={project.demoLink} target="_blank" rel="noopener noreferrer" class="plink plink-primary">
                <IconExternal />
                Live Demo
              </a>
              <a href={project.repoLink} target="_blank" rel="noopener noreferrer" class="plink">
                <IconGithub />
                Source Code
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: var(--spacing-xl);
  }

  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: var(--shadow-sm);

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }
  }

  .project-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;

    picture, img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
  }

  .project-status {
    position: absolute;
    bottom: var(--spacing-sm);
    right: var(--spacing-sm);
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--rounded-pill);

    &.status-done {
      background: var(--color-green-soft);
      color: var(--color-green);
    }

    &.status-progress {
      background: var(--color-accent-soft);
      color: var(--color-accent);
    }
  }

  .project-body {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ptag {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: var(--rounded-pill);
  }

  .project-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .project-desc {
    font-size: 13px;
    color: var(--color-ink-secondary);
    line-height: 1.7;
    margin: 0 0 4px;
  }

  .project-metrics {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .pmetric {
    font-size: 12px;
    color: var(--color-ink-secondary);

    strong {
      color: var(--color-primary);
      font-weight: 700;
    }
  }

  .project-links {
    margin-top: auto;
    padding-top: var(--spacing-sm);
    display: flex;
    gap: var(--spacing-md);
  }

  .plink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-secondary);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: var(--rounded-md);
    touch-action: manipulation;
    transition: color 0.2s ease, background 0.2s ease;

    &:hover {
      color: var(--color-primary);
      background: var(--color-primary-soft);
    }
  }

  .plink-primary {
    color: var(--color-on-primary);
    background: var(--color-primary);

    &:hover {
      color: var(--color-on-primary);
      background: var(--color-primary-deep);
    }
  }
</style>
