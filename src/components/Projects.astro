<style lang="scss">
  .content-section {
    padding: var(--spacing-xxl);
    @media (max-width: 768px) { padding: var(--spacing-xl) var(--spacing-lg); }
  }
  .bordered-top { border-top: 1px solid var(--color-glass-border); }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-lg);
  }

  .project-card {
    border-radius: var(--rounded-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;

    &:hover { transform: translateY(-4px); border-color: rgba(83,58,253,0.3); }
  }

  .project-img {
    position: relative;
    height: 180px;
    overflow: hidden;

    picture {
      width: 100%;
      height: 100%;
      display: block;
    }

    img { width: 100%; height: 100%; object-fit: cover; }
  }

  .project-overlay {
    position: absolute;
    bottom: var(--spacing-sm);
    right: var(--spacing-sm);
  }

  .project-status {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--rounded-pill);

    &.in-progress {
      background: rgba(246, 173, 85, 0.15);
      border: 1px solid rgba(246, 173, 85, 0.4);
      color: #f6ad55;
    }
    &.completed {
      background: rgba(74, 222, 128, 0.1);
      border: 1px solid rgba(74, 222, 128, 0.3);
      color: var(--color-green);
    }
  }

  .project-body {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    flex: 1;
  }

  .project-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .project-desc {
    font-size: 13px;
    color: var(--color-ink-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    background: rgba(83, 58, 253, 0.1);
    border: 1px solid rgba(83, 58, 253, 0.2);
    color: var(--color-primary);
    border-radius: var(--rounded-pill);
  }

  .project-metrics {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .metric {
    font-size: 12px;
    color: var(--color-ink-secondary);
  }

  .metric-val {
    color: var(--color-secondary);
    font-weight: 900;
    font-feature-settings: "tnum" on;
  }

  .project-links {
    margin-top: auto;
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-glass-border);
    display: flex;
    gap: var(--spacing-md);
  }

  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-ink-secondary);
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover { color: var(--color-primary); }
  }
</style>
