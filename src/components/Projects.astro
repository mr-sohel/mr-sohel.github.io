---
import IconExternal from './icons/IconExternal.astro';
import IconGithub from './icons/IconGithub.astro';
---
<section id="projects" class="section section-alt">
  <div class="section-inner">
    <span class="section-title-sm">Projects</span>
    <h2 class="section-title">What I've built</h2>

    <div class="projects-grid">
      <article class="project-card reveal">
        <div class="project-media">
          <picture>
            <source srcset="/images/online-judge.webp" type="image/webp" />
            <img src="/images/online-judge.webp" alt="Online Judge System built with ASP.NET Core and Docker showing code submission interface" width="800" height="400" loading="lazy" decoding="async" />
          </picture>
          <span class="project-status status-progress">In Progress</span>
        </div>
        <div class="project-body">
          <div class="project-tags">
            <span class="ptag">C#</span>
            <span class="ptag">ASP.NET Core</span>
            <span class="ptag">Docker</span>
            <span class="ptag">PostgreSQL</span>
            <span class="ptag">RabbitMQ</span>
          </div>
          <h3 class="project-title">Online Judge System</h3>
          <p class="project-desc">A containerized competitive programming judge with Docker-sandboxed code execution, RabbitMQ async job processing, and support for C++, Python, and Java — built to the same core architecture as Codeforces and LeetCode.</p>
          <div class="project-metrics">
            <span class="pmetric">
              <strong>10+ req/s</strong> under concurrent load
            </span>
            <span class="pmetric">
              <strong>&lt;500ms</strong> avg verdict
            </span>
            <span class="pmetric">
              <strong>3 languages</strong> supported
            </span>
          </div>
          <div class="project-links">
            <a href="https://online-judge-demo.vercel.app" target="_blank" rel="noopener noreferrer" class="plink plink-primary">
              <IconExternal />
              Live Demo
            </a>
            <a href="https://github.com/mr-sohel/online-judge-system" target="_blank" rel="noopener noreferrer" class="plink">
              <IconGithub />
              Source Code
            </a>
          </div>
        </div>
      </article>

      <article class="project-card reveal">
        <div class="project-media">
          <picture>
            <source srcset="/images/fruit-quality.webp" type="image/webp" />
            <img src="/images/fruit-quality.webp" alt="Real-Time Fruit Quality Detection system using YOLOv8 showing fresh vs rotten fruit classification" width="800" height="400" loading="lazy" decoding="async" />
          </picture>
          <span class="project-status status-done">Completed</span>
        </div>
        <div class="project-body">
          <div class="project-tags">
            <span class="ptag">Python</span>
            <span class="ptag">YOLOv8</span>
            <span class="ptag">FastAPI</span>
            <span class="ptag">ESP32-CAM</span>
          </div>
          <h3 class="project-title">Real-Time Fruit Quality Detection</h3>
          <p class="project-desc">End-to-end IoT + ML system that detects fresh vs rotten fruit using a $5 ESP32-CAM and a cloud-hosted YOLOv8 model streamed over WiFi.</p>
          <div class="project-metrics">
            <span class="pmetric">
              <strong>98.97%</strong> mAP@50
            </span>
            <span class="pmetric">
              <strong>80%</strong> faster vs YOLOv8n baseline
            </span>
            <span class="pmetric">
              <strong>3s</strong> end-to-end over WiFi
            </span>
          </div>
          <div class="project-links">
            <a href="https://fruit-quality-demo.vercel.app" target="_blank" rel="noopener noreferrer" class="plink plink-primary">
              <IconExternal />
              Live Demo
            </a>
            <a href="https://github.com/mr-sohel/fruit-quality-detection" target="_blank" rel="noopener noreferrer" class="plink">
              <IconGithub />
              Source Code
            </a>
          </div>
        </div>
      </article>

      <article class="project-card reveal">
        <div class="project-media">
          <picture>
            <source srcset="/images/autism-fer.webp" type="image/webp" />
            <img src="/images/autism-fer.webp" alt="Facial Emotion Recognition for Autism using Swin Transformer deep learning model" width="800" height="400" loading="lazy" decoding="async" />
          </picture>
          <span class="project-status status-done">Completed</span>
        </div>
        <div class="project-body">
          <div class="project-tags">
            <span class="ptag">Python</span>
            <span class="ptag">PyTorch</span>
            <span class="ptag">Swin Transformer</span>
            <span class="ptag">Grad-CAM</span>
          </div>
          <h3 class="project-title">Facial Emotion Recognition for Autism</h3>
          <p class="project-desc">Swin Transformer model classifying 7 facial emotions in autistic individuals — outperforming 14 published baselines. Undergraduate thesis project.</p>
          <div class="project-metrics">
            <span class="pmetric">
              <strong>89%</strong> Accuracy
            </span>
            <span class="pmetric">
              <strong>7</strong> Emotion classes
            </span>
            <span class="pmetric">
              <strong>14</strong> Baselines beaten
            </span>
          </div>
          <div class="project-links">
            <a href="https://fer-autism-demo.vercel.app" target="_blank" rel="noopener noreferrer" class="plink plink-primary">
              <IconExternal />
              Live Demo
            </a>
            <a href="https://github.com/mr-sohel/fer-autism" target="_blank" rel="noopener noreferrer" class="plink">
              <IconGithub />
              Source Code
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style lang="scss">
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: var(--spacing-xl);
  }

  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: var(--shadow-sm);

    &:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }
  }

  .project-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;

    picture, img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
  }

  .project-status {
    position: absolute;
    bottom: var(--spacing-sm);
    right: var(--spacing-sm);
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--rounded-pill);

    &.status-done {
      background: var(--color-green-soft);
      color: var(--color-green);
    }

    &.status-progress {
      background: var(--color-accent-soft);
      color: var(--color-accent);
    }
  }

  .project-body {
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ptag {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    border-radius: var(--rounded-pill);
  }

  .project-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }

  .project-desc {
    font-size: 13px;
    color: var(--color-ink-secondary);
    line-height: 1.7;
    margin: 0 0 4px;
  }

  .project-metrics {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .pmetric {
    font-size: 12px;
    color: var(--color-ink-secondary);

    strong {
      color: var(--color-primary);
      font-weight: 700;
    }
  }

  .project-links {
    margin-top: auto;
    padding-top: var(--spacing-sm);
    display: flex;
    gap: var(--spacing-md);
  }

  .plink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink-secondary);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: var(--rounded-md);
    touch-action: manipulation;
    transition: color 0.2s ease, background 0.2s ease;

    &:hover {
      color: var(--color-primary);
      background: var(--color-primary-soft);
    }
  }

  .plink-primary {
    color: var(--color-on-primary);
    background: var(--color-primary);

    &:hover {
      color: var(--color-on-primary);
      background: var(--color-primary-deep);
    }
  }
</style>
