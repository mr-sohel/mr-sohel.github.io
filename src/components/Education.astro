---
import { education, person } from '../data/profile';
---

<section id="education" class="block">
  <h2 class="section-title">Education</h2>

  <h3 class="degree">{education.degree}</h3>
  <p class="school">{person.university}</p>

  <dl class="facts">
    <div>
      <dt class="label">CGPA</dt>
      <dd>{education.cgpa}</dd>
    </div>
    <div>
      <dt class="label">Expected graduation</dt>
      <dd><time datetime="2026-12">{person.graduation}</time></dd>
    </div>
    <div class="facts-wide">
      <dt class="label">Coursework</dt>
      <dd>{education.coursework}</dd>
    </div>
  </dl>
</section>

<style lang="scss">
  .section-title {
    margin-bottom: var(--spacing-xl);
  }

  .degree {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .school {
    margin: 2px 0 var(--spacing-lg);
    font-weight: 500;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-lg);
    margin: 0;
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);

    dt {
      color: var(--color-ink-mute);
    }

    dd {
      margin: 0;
      font-weight: 500;
    }
  }

  .facts-wide {
    grid-column: 1 / -1;
  }
</style>
