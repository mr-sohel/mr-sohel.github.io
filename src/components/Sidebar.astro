---
---

<aside class="sidebar glass" aria-label="Profile sidebar">
  <!-- Avatar with shimmer ring -->
  <div class="avatar-wrapper">
    <div class="avatar-ring">
      <img
        src="/avatar.jpg"
        alt="Md. Sohel Rana — profile photo"
        width="110"
        height="110"
        class="avatar-img"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <!-- Name -->
  <h1 class="sidebar-name">Md. Sohel Rana</h1>

  <!-- Badge pills -->
  <div class="badge-cluster">
    <span class="badge">Final Year @ BUBT</span>
    <span class="badge">ICPC Regionalist</span>
    <span class="badge">CF Specialist</span>
    <span class="badge">LC Knight</span>
    <span class="badge">3★ CodeChef</span>
  </div>

  <div class="divider" aria-hidden="true"></div>

  <!-- Social icons -->
  <nav class="social-grid" aria-label="Social profiles">
    <a href="mailto:mrsohelcse@gmail.com" class="social-btn" title="Email" aria-label="Send email">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 512 512" fill="currentColor"><path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48L48 64zM0 176L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-208L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"/></svg>
      <span class="social-tooltip">Email</span>
    </a>
    <a href="https://github.com/mr-sohel" target="_blank" rel="noopener noreferrer" class="social-btn" title="GitHub" aria-label="GitHub profile">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 496 512" fill="currentColor"><path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3zm44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8z"/></svg>
      <span class="social-tooltip">GitHub</span>
    </a>
    <a href="https://www.linkedin.com/in/mrsohel/" target="_blank" rel="noopener noreferrer" class="social-btn" title="LinkedIn" aria-label="LinkedIn profile">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 448 512" fill="currentColor"><path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"/></svg>
      <span class="social-tooltip">LinkedIn</span>
    </a>
    <a href="https://codeforces.com/profile/mr_sohel" target="_blank" rel="noopener noreferrer" class="social-btn" title="Codeforces" aria-label="Codeforces profile">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <rect x="4" y="14" width="4" height="6"/><rect x="10" y="8" width="4" height="12"/><rect x="16" y="4" width="4" height="16"/>
      </svg>
      <span class="social-tooltip">Codeforces</span>
    </a>
    <a href="https://leetcode.com/u/mr_sohel/" target="_blank" rel="noopener noreferrer" class="social-btn" title="LeetCode" aria-label="LeetCode profile">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"/></svg>
      <span class="social-tooltip">LeetCode</span>
    </a>
    <a href="https://codolio.com/profile/mr_sohel" target="_blank" rel="noopener noreferrer" class="social-btn" title="Codolio" aria-label="Codolio profile">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      <span class="social-tooltip">Codolio</span>
    </a>
  </nav>

  <div class="divider" aria-hidden="true"></div>

  <!-- Location + theme toggle -->
  <div class="sidebar-footer">
    <div class="location-chip">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <div>
        <p class="location-label">Location</p>
        <p class="location-value">Dhaka, Bangladesh</p>
      </div>
    </div>

    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark theme">
      <svg class="sun-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="moon-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </div>
</aside>

<script>
  // Theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
</script>

<style lang="scss">
  .sidebar {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-xl) var(--spacing-lg);
    border-radius: var(--rounded-2xl);
    gap: var(--spacing-md);
    overflow: hidden;
  }

  /* Avatar */
  .avatar-wrapper {
    margin-top: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  .avatar-ring {
    position: relative;
    padding: 3px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary), var(--color-accent));
    background-size: 200% 200%;
    animation: shimmer 4s ease infinite;
  }

  .avatar-img {
    display: block;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-bg);
  }

  /* Name */
  .sidebar-name {
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.5px;
    text-align: center;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
    text-wrap: balance;
  }

  /* Badges */
  .badge-cluster {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .badge {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--rounded-pill);
    border: 1px solid var(--color-glass-border);
    background: var(--color-glass);
    color: var(--color-ink-secondary);
    transition: color 0.2s ease, border-color 0.2s ease;
    cursor: default;

    &:hover {
      border-color: rgba(83, 58, 253, 0.4);
      color: var(--color-primary);
    }
  }

  /* Divider */
  .divider {
    width: 100%;
    height: 1px;
    background: var(--color-glass-border);
    margin: var(--spacing-xs) 0;
  }

  /* Social grid */
  .social-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-sm);
  }

  .social-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--rounded-lg);
    background: var(--color-glass);
    border: 1px solid var(--color-glass-border);
    color: var(--color-ink-secondary);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;

    &:hover {
      background: rgba(83, 58, 253, 0.2);
      border-color: rgba(83, 58, 253, 0.4);
      color: var(--color-primary);
      transform: translateY(-2px);
    }
  }

  /* Tooltip */
  .social-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    border-radius: var(--rounded-sm);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    z-index: 50;
  }

  .social-btn:hover .social-tooltip {
    opacity: 1;
  }

  /* Sidebar footer */
  .sidebar-footer {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xs);
  }

  .location-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-glass);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--rounded-lg);
    flex: 1;

    svg {
      flex-shrink: 0;
      color: var(--color-ink-secondary);
    }

    p { margin: 0; }

    .location-label {
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--color-ink-mute);
    }

    .location-value {
      font-size: 12px;
      font-weight: 700;
      color: var(--color-ink);
    }
  }

  /* Theme toggle */
  .theme-toggle {
    background: var(--color-glass);
    border: 1px solid var(--color-glass-border);
    color: var(--color-ink-secondary);
    cursor: pointer;
    padding: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--rounded-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, background 0.2s ease;
    flex-shrink: 0;

    &:hover {
      color: var(--color-primary);
      background: rgba(83, 58, 253, 0.1);
    }
  }

  .sun-icon { display: none; }
  .moon-icon { display: block; }

  :global([data-theme="light"]) .sun-icon { display: block; }
  :global([data-theme="light"]) .moon-icon { display: none; }
</style>
