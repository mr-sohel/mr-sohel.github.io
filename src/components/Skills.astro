---
const sections = [
  {
    label: "Languages",
    skills: ["C#", "C++", "Python", "SQL"]
  },
  {
    label: "Frontend",
    skills: ["HTML", "CSS", "JavaScript"]
  },
  {
    label: "Databases",
    skills: ["MySQL", "SQL Server", "PostgreSQL"]
  },
  {
    label: "Tools",
    skills: ["Git", "Linux"]
  },
  {
    label: "Core CS",
    skills: ["Data Structures", "Algorithms", "Object-Oriented Programming (OOP)", "Database Management Systems", "Operating Systems", "Computer Networks"]
  }
];
---

<section id="skills" class="section section-alt">
  <div class="section-inner">
    <span class="section-title-sm">Skills</span>
    <h2 class="section-title">Tools &amp; technologies</h2>

    <div class="skills-list">
      {sections.map((s) => (
        <div class="skill-row reveal">
          <span class="skill-label">{s.label}</span>
          <div class="skill-chips">
            {s.skills.map((skill) => (
              <span class="chip">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .skill-row {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xl);
    padding: var(--spacing-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rounded-xl);
    box-shadow: var(--shadow-sm);

    @media (max-width: 640px) {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    @media (max-width: 400px) {
      padding: var(--spacing-md);
    }
  }

  .skill-label {
    flex-shrink: 0;
    width: 160px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--color-primary);

    @media (max-width: 640px) {
      width: auto;
    }
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    font-size: 13px;
    font-weight: 500;
    padding: 5px 14px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--rounded-pill);
    color: var(--color-ink-secondary);
  }
</style>
